import { UiButton as Button, UiTextField as LineEdit, UiScrollView as ScrollView } from "presets.slint";
import { Theme } from "theme.slint";
import { DialogSurface, DialogActions, Heading, Note } from "components.slint";
export component TulkkiQrDialog inherits Rectangle {
    in property <image> qr;
    in property <string> link;
    in property <string> code;
    callback close;
    background:Theme.modal-backdrop;TouchArea {}
    Timer {interval:1ms;running:true;triggered=>{self.running=false;close-button.focus();}}
    FocusScope {
        width:root.width;height:root.height;init=>{close-button.focus();}
        capture-key-pressed(event)=>{if event.text==Key.Escape{root.close();return accept;}if event.text==Key.Tab {if close-button.has-focus{link-field.focus();}else{close-button.focus();}return accept;}reject}
        DialogSurface {
            available-width:root.width;available-height:root.height;preferred-dialog-width:560px;preferred-dialog-height:640px;
            VerticalLayout {
                padding:Theme.dialog-padding;spacing:Theme.space-2;
                Heading {text:"Liity kilpailuun QR-koodilla";}
                ScrollView { VerticalLayout {spacing:Theme.space-2;
                Note {text:"Lue koodi puhelimen kameralla. Anna avautuvassa AS tulkissa tarkastajan nimi ja paina Liity kilpailuun.";}
                HorizontalLayout {
                    alignment:center;
                    Image {width:root.height<500px ? 144px : root.height<700px ? 220px : 288px;height:self.width;source:root.qr;image-fit:contain;image-rendering:pixelated;accessible-label:"Kilpailun liittymisen QR-koodi";}
                }
                Note {text:"Liittymiskoodi: "+root.code;}
                link-field:=LineEdit {text:root.link;read-only:true;accessible-label:"Kilpailuun liittymislinkki";}
                }}
                DialogActions {close-button:=Button {text:"Sulje";clicked=>{root.close();}}}
            }
        }
    }
}
