import { Button, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { DrawClassOption } from "types.slint";

export component DrawClassDialog inherits Rectangle {
    in property <[DrawClassOption]> classes;
    in property <string> summary;
    callback toggle(int, bool);
    callback select-all(bool);
    callback close(bool);
    background: Theme.modal-backdrop;
    TouchArea { }
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { cancel.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            if event.text == Key.Tab {
                if save.has-focus && !event.modifiers.shift { all.focus(); return accept; }
                if all.has-focus && event.modifiers.shift { save.focus(); return accept; }
            }
            reject
        }
        DialogSurface {
            available-width: root.width;
            available-height: root.height;
            preferred-dialog-height: 580px;
            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.space-3;
                Heading { text: "Lähtöarvonnan luokat"; }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        spacing: Theme.space-3;
                        Note { text: "Valitse arvontaan osallistuvat luokat."; }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            all := Button { text: "Valitse kaikki"; clicked => { root.select-all(true); } }
                            Button { text: "Tyhjennä valinta"; clicked => { root.select-all(false); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        for entry[i] in root.classes: Rectangle {
                            height: Theme.row-height;
                            vertical-stretch: 0;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                CheckBox {
                                    text: entry.label;
                                    checked: entry.selected;
                                    toggled => { root.toggle(i, self.checked); }
                                }
                            }
                        }
                        if root.summary != "": Note { text: root.summary; }
                    }
                }
                DialogActions {
                    cancel := Button { text: "Peruuta"; clicked => { root.close(false); } }
                    save := AccentButton { text: "Tallenna valinnat"; clicked => { root.close(true); } }
                }
            }
        }
    }
}
