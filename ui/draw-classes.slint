import { ClassSelection } from "class-selection.slint";
import { UiButton as Button } from "presets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { DrawClassOption } from "types.slint";

export component DrawClassDialog inherits Rectangle {
    in property <[DrawClassOption]> classes;
    in property <string> summary;

    callback toggle(int, bool);
    callback select-all(bool);
    callback close(bool);
    background: Theme.modal-backdrop;
    TouchArea { }
    Timer { interval: 1ms; running: true; triggered => { self.running = false; cancel.focus(); } }
    FocusScope {
        width: root.width; height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            if event.text == Key.Tab {
                if save.has-focus && !event.modifiers.shift { choices.focus-search(); return accept; }
                if choices.search-focused && event.modifiers.shift { save.focus(); return accept; }
            }
            reject
        }
        DialogSurface {
            available-width: root.width;
            available-height: root.height;
            minimum-dialog-height: 340px; maximum-dialog-height: 1000px;
            preferred-dialog-width: 760px;
            content-dialog-height: form-layout.min-height - choices.min-height + 124px + ceil(root.classes.length / 2) * 48px + 24px;
            form-layout := VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.space-3;
                Heading { text: "Lähtöarvonnan luokat"; }
                choices := ClassSelection {
                    min-height: 200px; vertical-stretch: 1;
                    classes: root.classes;
                    toggle(index, selected) => { root.toggle(index, selected); }
                    select-all(selected) => { root.select-all(selected); }
                }
                if root.summary != "": Note { text: root.summary; }
                DialogActions {
                    cancel := Button { text: "Peruuta";  clicked => { root.close(false); } }
                    save := AccentButton { text: "Arvo lähtöajat";  clicked => { root.close(true); } }
                }
            }
        }
    }
}
