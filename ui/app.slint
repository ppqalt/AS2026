import { Palette, AboutSlint } from "std-widgets.slint";
import { UiButton as Button, UiTextField as LineEdit, UiScrollView as ScrollView, UiComboBox as ComboBox, UiCheckBox as CheckBox } from "presets.slint";
import { Theme } from "theme.slint";
export { Theme }
import { TableRow, EditorField, ResultOverview, DrawClassOption, BcStationOption } from "types.slint";
import { Heading, Note, NavItem, DataTable, Editor, Metric, AccentButton, DialogSurface, DialogActions, Workspace } from "components.slint";
import { ResultSummary } from "results.slint";
export { GalleryWindow } from "fluent-gallery.slint";
import { StartColumnsDialog } from "start-columns.slint";
import { DrawClassDialog } from "draw-classes.slint";
import { CombinedClassDialog } from "combined-class.slint";
import { BeginnersCupDialog } from "beginners-cup.slint";
import { LivePublishDialog } from "live-publish.slint";
import { ResultEntryDialog } from "result-entry.slint";
import { EmitCorrectionDialog } from "emit-correction.slint";
import { PrintClassesDialog } from "print-classes.slint";
import { ResultEntryInput } from "types.slint";
export { ResultEntryInput }
export { TableRow, EditorField, ResultOverview, DrawClassOption, BcStationOption }

export component AppWindow inherits Window {
    init => { Palette.color-scheme = Theme.color-scheme; }
    private property <ColorScheme> resolved-color-scheme: Theme.color-scheme;
    changed resolved-color-scheme => { Palette.color-scheme = root.resolved-color-scheme; }
    in-out property <int> appearance-index: 0;
    callback set-appearance(int);
    changed appearance-index => { Theme.appearance-index = root.appearance-index; }
    title: "AS2026 — " + root.competition-name;
    preferred-width: 1480px; preferred-height: 960px;
    min-width: 900px; min-height: 600px;
    background: Theme.canvas;
    default-font-size: Theme.body-font-size;
    default-font-family: Theme.font-family;
    forward-focus: keyboard;
    in-out property <int> page: 0;
    in-out property <bool> opened;
    in-out property <bool> editable;
    in-out property <bool> demo;
    in-out property <string> competition-name: "Ei avointa kilpailua";
    in-out property <string> competition-path;
    in-out property <string> status-text: "Avaa kilpailu tai perusta uusi.";
    in-out property <string> status-summary: "Avaa kilpailu tai perusta uusi.";
    in-out property <bool> status-error;
    in-out property <int> driver-count;
    in-out property <int> class-count;
    in-out property <int> track-count;
    in-out property <int> read-count;
    in-out property <int> unsaved-count;
    in-out property <string> filter;
    in-out property <[string]> result-classes: ["Luokka"];
    in-out property <int> result-class-index;
    callback result-class-changed(int);
    in-out property <[TableRow]> rows;
    in-out property <[string]> headers;
    in-out property <[float]> weights;
    in-out property <int> selected-key: -1;
    in-out property <[TableRow]> detail-rows;
    in-out property <[string]> detail-headers;
    in-out property <[float]> detail-weights;
    in-out property <int> detail-key: -1;
    in-out property <string> detail-title;
    in-out property <bool> editor-visible;
    in-out property <bool> competitor-details-open;
    in-out property <bool> competitor-edit-open;
    changed competitor-edit-open => { if !root.competitor-edit-open { root.focus-page(); } }
    in-out property <bool> new-record;
    in-out property <bool> form-blocked;
    in-out property <string> editor-title;
    in-out property <string> editor-description;
    in-out property <string> editor-error;
    in-out property <[EditorField]> fields;
    // The route editor is independent from station selection.
    in-out property <bool> station-editor-focused;
    changed detail-key => { if root.page == 5 { root.station-editor-focused = root.detail-key >= 0 || root.editor-title == "Uusi asema"; } }
    changed editor-title => { if root.editor-title == "Uusi asema" { root.station-editor-focused = true; } }
    in-out property <bool> route-editor-visible;
    in-out property <[EditorField]> route-fields;
    in-out property <bool> reader-running;
    in-out property <string> reader-status: "Lukijaa ei ole käynnistetty.";
    in-out property <string> reader-port;
    in-out property <string> read-notice;
    in-out property <bool> read-notice-visible;
    in-out property <string> calculation-notes;
    in-out property <int> calculation-note-count;
    in-out property <ResultOverview> result-overview;
    in-out property <string> app-version;
    in-out property <bool> lan-open;
    in-out property <bool> lan-active;
    in-out property <bool> lan-hosting;
    in-out property <bool> lan-busy;
    in-out property <string> lan-status: "Lähiverkko";
    in-out property <string> lan-address;
    in-out property <string> lan-code;
    in-out property <string> lan-info;
    in-out property <string> lan-host-address;
    in-out property <string> lan-error;
    callback lan-host();
    callback lan-join();
    callback lan-leave();
    callback lan-discover();
    changed lan-open => { if !root.lan-open { root.focus-page(); } }

    in-out property <bool> start-columns-open;
    in-out property <[DrawClassOption]> start-columns;
    in-out property <string> start-columns-error;
    callback configure-start-columns();
    callback start-column-toggled(int, bool);
    callback move-start-column(int, int);
    callback start-columns-close(bool);
    changed start-columns-open => { if !root.start-columns-open { root.focus-page(); } }
    in-out property <string> default-root;
    in-out property <[string]> printers;
    in-out property <int> printer-index;
    in-out property <string> printer-name: "Käyttöjärjestelmän oletus";
    callback refresh-printers();
    callback select-printer(int);
    in-out property <bool> print-busy;
    in-out property <bool> publish-open;
    in-out property <bool> publish-running;
    in-out property <bool> publish-busy;
    in-out property <string> publish-status;
    in-out property <int> publish-protocol;
    in-out property <[ResultEntryInput]> publish-fields;
    callback open-publish();
    callback publish-edited(int, string);
    in-out property <[DrawClassOption]> publish-classes;
    callback publish-class-toggled(int, bool);
    callback publish-local();
    callback publish-test();
    callback publish-toggle();
    callback publish-finish();
    in-out property <bool> result-entry-open;
    in-out property <string> result-entry-identity;
    in-out property <string> result-entry-queue;
    in-out property <[ResultEntryInput]> result-entry-fields;
    in-out property <string> result-entry-error;
    in-out property <int> result-entry-focus;
    callback result-entry-edited(int, string);
    callback result-entry-close(bool);
    callback result-entry-save();
    in-out property <bool> emit-edit-open;
    in-out property <string> emit-edit-identity;
    in-out property <[EditorField]> emit-edit-fields;
    in-out property <string> emit-edit-error;
    in-out property <string> emit-edit-history;
    callback open-emit-edit();
    callback emit-edit-edited(int, string);
    callback emit-edit-add(bool);
    callback delete-class();
    callback emit-edit-close(bool);
    in-out property <bool> print-classes-open;
    in-out property <bool> print-stations;
    in-out property <[DrawClassOption]> print-classes;
    in-out property <bool> print-landscape;
    in-out property <bool> print-fit: true;
    in-out property <string> print-error;
    callback open-print-classes(bool);
    callback print-class-toggled(int, bool);
    callback print-classes-all(bool);
    callback print-classes-close(bool);
    in-out property <string> update-status: "Päivityksiä ei ole tarkistettu.";
    in-out property <string> available-version;
    in-out property <bool> update-busy;
    in-out property <bool> install-busy;
    in-out property <bool> managed;
    in-out property <bool> installable;
    in-out property <bool> setup-open;
    in-out property <bool> new-location-visible;
    callback change-default-root();
    callback reset-default-root();
    callback check-updates();
    callback apply-update();
    callback install-app();
    function begin-new() {
        if !root.prepare-new() { return; }
        root.new-path = "";
        root.new-name = "";
        root.new-location-visible = false;
        root.new-error = "";
        root.dialog-open = true;
    }
    in-out property <bool> dialog-open;
    in-out property <bool> about-open;
    // User-selected optional UI animations/effects; persisted by Rust.
    in-out property <bool> effects-enabled: false;
    callback set-effects-enabled(bool);
    changed effects-enabled => {
        Theme.effects-enabled = root.effects-enabled;
        if !root.effects-enabled { root.tung-active = false; }
    }
    property <string> tung-keys;
    in-out property <bool> tung-active;
    in-out property <[int]> tung-speeds;
    property <int> tung-frame;
    callback tung-start();
    Timer {
        interval: 5s;
        running: root.effects-enabled && root.tung-active;
        triggered => { root.tung-active = false; }
    }
    Timer {
        interval: 16ms;
        running: root.tung-active;
        triggered => { root.tung-frame += 1; }
    }
    in-out property <string> new-name;
    in-out property <string> new-error;
    in-out property <string> new-path;
    in-out property <string> path-input;
    callback navigate(int);
    callback focus-page();
    focus-page => {
        if !root.start-columns-open && !root.lan-open && !root.export-open && !root.notes-open && !root.dialog-open && !root.about-open && !root.confirm-open && !root.draw-classes-open && !root.combined-open && !root.bc-open && !root.status-details-open && !root.setup-open && !root.install-busy {
            keyboard.focus();
        }
    }
    changed notes-open => { root.note-details-open = false; if !root.notes-open { root.focus-page(); } }
    changed dialog-open => { if !root.dialog-open { root.focus-page(); } }
    changed about-open => { root.tung-keys = ""; if !root.about-open { root.tung-active = false; root.focus-page(); } }
    changed confirm-open => { if !root.confirm-open { root.focus-page(); } }
    changed draw-classes-open => { if !root.draw-classes-open { root.focus-page(); } }
    changed bc-open => { if !root.bc-open { root.focus-page(); } }
    changed combined-open => { if !root.combined-open { root.focus-page(); } }
    changed status-details-open => { if !root.status-details-open { root.focus-page(); } }
    changed setup-open => { if !root.setup-open { root.focus-page(); } }
    callback open-file();
    callback open-path(string);
    callback create-project(string, string);
    callback prepare-new() -> bool;
    callback browse-new-path();
    callback open-demo();
    callback reload();
    callback filter-changed(string);
    callback select-row(int);
    callback select-detail(int);
    callback edit-result-competitor();
    callback import-excel();
    in-out property <bool> import-open;
    in-out property <string> import-name;
    in-out property <string> import-details;
    in-out property <string> import-error;
    in-out property <string> import-root;
    in-out property <bool> import-location-open;
    callback browse-import-root();
    in-out property <bool> import-details-open;
    in-out property <bool> import-mapping-open;
    in-out property <int> import-mode;
    in-out property <int> import-tab;
    in-out property <[string]> import-classes;
    in-out property <[string]> import-routes;
    in-out property <[int]> import-route-choices;
    in-out property <[TableRow]> import-rows;
    in-out property <[TableRow]> import-station-rows;
    callback import-class-route(string, string);
    callback import-selection(int);
    private property <bool> path-open;
    in-out property <bool> status-details-open;
    callback show-export-menu();
    show-export-menu => { export-menu.show(); }
    private property<bool> extras-export-mode: false;
    function export-from-extras() {
        // Pidetään sama popup auki: alkuperäisen ikkunan sulkeminen ja uuden
        // avaaminen samassa syötteessä voi hävittää Waylandin popup-kohdistuksen.
        root.extras-export-mode = true;
    }
    export-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: root.width - Theme.gutter - self.width;
        y: Theme.gutter + Theme.control-height + Theme.space-2;
        width: 180px; height: 3 * Theme.control-height + 4 * Theme.space-2;
        Rectangle {
            background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius-large;
            VerticalLayout {
                padding: Theme.space-2; spacing: Theme.space-2;
                export-excel := Button { text: "Excel (XLSX)"; clicked => { root.export-xlsx(); export-menu.close(); } }
                Button { text: "CSV"; clicked => { root.export-csv(); export-menu.close(); } }
                Button { text: "HTML"; clicked => { root.export-report(); export-menu.close(); } }
            }
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; init => { export-excel.focus(); } }
        }
    }
    in-out property <bool> export-open;
    changed export-open => { if !root.export-open { root.focus-page(); } }
    in-out property <int> export-kind;
    in-out property <string> export-label;
    in-out property <string> export-path;
    in-out property <string> export-error;
    callback save-export();
    callback browse-export();
    in-out property <string> calculation-note-details;
    in-out property <bool> note-details-open;
    in-out property <bool> notes-open;
    in-out property <bool> result-stations;
    in-out property <bool> details-open;
    changed page => { root.details-open = false; root.result-stations = false; root.notes-open = false; }
    callback show-extras-menu();
    show-extras-menu => { root.extras-export-mode = false; extras-menu.show(); }
    callback approve-results();
    in-out property <bool> result-approvable: false;
    in-out property <bool> result-interrupted: false;
    callback add-record();
    callback add-station();
    callback move-station(int);
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    callback route-field-commit(int, string) -> bool;
    callback route-field-draft(int, string);
    callback add-commit();
    callback cancel-edit();
    callback export-report();
    callback export-csv();
    callback export-xlsx();
    callback reader-start(string);
    callback reader-stop();
    callback retry-readouts();
    callback import-frame();
    callback review-results();
    callback examine-results();
    callback draw-starts();
    in-out property <bool> draw-classes-open;
    in-out property <[DrawClassOption]> draw-classes;
    in-out property <string> draw-class-summary;
    callback configure-draw-classes();
    callback draw-class-toggled(int, bool);
    callback draw-classes-all(bool);
    callback draw-classes-close(bool);
    in-out property <bool> combined-open;
    in-out property <bool> combined-creating;
    in-out property <int> combined-index;
    in-out property <string> combined-name;
    in-out property <[DrawClassOption]> combined-classes;
    in-out property <int> combined-np;
    in-out property <int> combined-sp;
    in-out property <string> combined-error;
    callback add-combined-class();
    callback combined-class-toggled(int, bool);
    callback combined-close(bool);
    in-out property <bool> bc-open;
    in-out property <bool> bc-configured;
    in-out property <string> bc-name;
    in-out property <string> bc-code;
    in-out property <[string]> bc-routes;
    in-out property <int> bc-route;
    in-out property <[BcStationOption]> bc-stations;
    in-out property <[DrawClassOption]> bc-participants;
    in-out property <string> bc-error;
    in-out property <bool> bc-results;
    callback configure-bc();
    callback bc-route-selected(int);
    callback bc-station-toggled(int, bool);
    callback bc-participant-toggled(int, bool);
    callback bc-close(bool);
    callback result-scope(bool);
    callback export-starts();
    in-out property <bool> result-stored;
    in-out property <bool> examine-supported;
    in-out property <bool> clock-pending;
    in-out property <bool> confirm-open;
    in-out property <string> confirm-title;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action-label: "Hyväksy";
    in-out property <bool> confirm-acceptable: true;
    callback confirm-action(bool);

    // Pikanäppäimet toimivat myös kentän tai taulukon ollessa kohdistettuna.
    keyboard := FocusScope {
    enabled: !root.competitor-edit-open;
    focus-on-click: false;
    focus-on-tab-navigation: false;
    capture-key-pressed(event) => {
        if root.install-busy { return accept; }
        if event.text == Key.Escape {
            if root.start-columns-open { root.start-columns-close(false); return accept; }
            if root.emit-edit-open { root.emit-edit-close(false); return accept; }
            if root.lan-open { root.lan-open = false; return accept; }
            if root.export-open { root.export-open = false; return accept; }
            if root.publish-open { root.publish-open = false; return accept; }
            if root.result-entry-open { root.result-entry-close(false); return accept; }
            if root.print-classes-open { root.print-classes-close(false); return accept; }
            if root.notes-open { root.notes-open = false; return accept; }
            if root.setup-open {
                root.setup-open = false;
                return accept;
            } else if root.status-details-open {
                root.status-details-open = false;
                return accept;
            } else if root.combined-open {
                root.combined-close(false);
                return accept;
            } else if root.bc-open {
                root.bc-close(false);
                return accept;
            } else if root.draw-classes-open {
                root.draw-classes-close(false);
                return accept;
            } else if root.confirm-open {
                root.confirm-action(false);
                return accept;
            } else if root.about-open {
                root.about-open = false;
                return accept;
            } else if root.dialog-open {
                root.dialog-open = false;
                return accept;
            } else if root.new-record || root.form-blocked {
                root.cancel-edit();
                return accept;
            }
        }
        if event.modifiers.control && !root.start-columns-open && !root.lan-open && !root.export-open && !root.emit-edit-open && !root.publish-open && !root.result-entry-open && !root.print-classes-open && !root.notes-open && !root.dialog-open && !root.about-open && !root.confirm-open && !root.draw-classes-open && !root.combined-open && !root.bc-open && !root.status-details-open && !root.setup-open {
            if event.text == "o" || event.text == "O" {
                root.open-file();
                return accept;
            } else if event.text == "n" || event.text == "N" {
                root.begin-new();
                return accept;
            }
        }
        reject
    }
    // Yksi navigaatiorakenne ja samat komponentit jokaiselle näkymälle.
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: Theme.sidebar-width; background: Theme.sidebar;
            VerticalLayout {
                padding: Theme.space-3; spacing: Theme.space-1;
                Rectangle {
                    height: 52px; vertical-stretch: 0;
                    Text {
                        x: Theme.space-2; y: Theme.space-2;
                        width: parent.width - 2 * Theme.space-2;
                        text: root.competition-name;
                        color: Theme.ink; font-size: Theme.section-font-size;
                        font-weight: 700; overflow: elide;
                    }
                }
                Rectangle {
                    height: 40px; vertical-stretch: 0;
                    Button {
                    x: Theme.space-2; y: -Theme.space-1;
                    width: nav-scroll.visible-width;
                    height: 40px;
                    text: root.lan-busy ? "Yhdistetään…" : root.lan-active ? root.lan-status : "Yhteys: paikallinen";
                    accessible-label: root.lan-status;
                    clicked => {
                        root.lan-open = true;
                        if !root.lan-active && !root.lan-busy && root.lan-address == "" { root.lan-discover(); }
                    }
                }
                }
                Rectangle { height: Theme.space-2; vertical-stretch: 0; }
                nav-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: nav-items.min-height;
                    nav-items := VerticalLayout {
                        x: 0px; y: 0px;
                        width: nav-scroll.visible-width;
                        height: self.min-height;
                        spacing: Theme.space-1;
                        for label[index] in ["Yleiskatsaus", "Kilpailijat", "Emit", "Tulokset", "Luokat", "Radat ja asemat", "Asetukset"]: NavItem {
                            label: label;
                            active: root.page == index;
                            chosen => { root.navigate(index); }
                        }
                    }
                }
                Button {
                    height: Theme.control-height;
                    text: root.update-busy ? "Tarkistetaan" : root.available-version != "" ? "Asenna " + root.available-version : "Päivitykset ↻";
                    enabled: !root.update-busy && !root.install-busy;
                    clicked => {
                        if root.available-version != "" { root.apply-update(); }
                        else { root.check-updates(); }
                    }
                }
                if root.available-version != "": Note {
                    text: "Asennus käynnistää sovelluksen uudelleen.";
                    font-size: Theme.caption-font-size;
                }
                Button { height: Theme.control-height; text: "Tietoja"; clicked => { root.about-open = true; } }
                Rectangle {
                    height: 56px; background: Theme.surface-raised; border-radius: Theme.radius;
                    VerticalLayout {
                        padding: Theme.space-2; spacing: Theme.space-1;
                        Text { text: root.reader-running ? "●  Emit-lukija käynnissä" : "○  Emit-lukija pysäytetty"; color: root.reader-running ? Theme.success : Theme.muted; font-size: Theme.caption-font-size; }
                        Text { text: "AS2026 " + root.app-version; color: Theme.subtle-text; font-size: Theme.caption-font-size; }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.gutter; spacing: Theme.space-4;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-1;
                        Heading { text: ["Kilpailun yleiskatsaus", "Kilpailijat", "Emit", "Tulokset", "Luokat", "Radat ja asemat", "Asetukset"][root.page]; }
                    }
                    if root.page == 3 && root.opened: LineEdit { preferred-width: 230px; text <=> root.filter; placeholder-text: "Hae kilpailijaa"; edited => { root.filter-changed(self.text); } }
                    if root.page == 3 && root.opened: Rectangle { width: Theme.space-3; }
                    if root.page == 3 && root.opened: ComboBox { preferred-width: 180px; model: root.result-classes; current-index <=> root.result-class-index; selected(index) => { root.result-class-changed(self.current-index); }

                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        visible: root.opened || root.page == 0;
                        width: 106px; height: Theme.control-height;
                        Button { width: 100%; height: 100%; text: "Toiminnot"; menu-button: true; accessible-label: "Lisätoiminnot"; clicked => { root.show-extras-menu(); } }
                        extras-menu := PopupWindow {
                            close-policy: close-on-click-outside;
                            x: parent.width - self.width; y: parent.height + Theme.space-2;
                            width: 280px; height: root.extras-export-mode ? 144px : root.page == 1 || root.page == 3 ? 232px : root.page == 0 || root.page == 4 ? 188px : root.page == 5 ? 144px : root.page == 2 ? 100px : 56px;
                            Rectangle {
                                background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius-large;
                                if root.extras-export-mode: Rectangle {
                                    VerticalLayout {
                                        padding: Theme.space-2; spacing: Theme.space-2;
                                        nested-excel := Button { text: "Excel (XLSX)"; clicked => { root.export-xlsx(); extras-menu.close(); } }
                                        Button { text: "CSV"; clicked => { root.export-csv(); extras-menu.close(); } }
                                        Button { text: "HTML"; clicked => { root.export-report(); extras-menu.close(); } }
                                    }
                                    FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; init => { nested-excel.focus(); } }
                                }
                                Rectangle {
                                    visible: !root.extras-export-mode;
                                    VerticalLayout {
                                        padding: Theme.space-2; spacing: Theme.space-2;
                                    refresh-menu := Button { text: "Päivitä tiedot"; enabled: true; clicked => { root.focus-page(); root.reload(); extras-menu.close(); } }
                                    if root.page == 0: Button { text: "Avaa"; clicked => { root.open-file(); extras-menu.close(); } }
                                    if root.page == 0: Button { text: "+ Uusi"; clicked => { root.begin-new(); extras-menu.close(); } }
                                    if root.page == 0: Button { text: "Tuo kilpailu Excelistä"; clicked => { root.import-excel(); extras-menu.close(); } }
                                    if root.page == 1 || root.page == 5: Button { text: "Tuo Excel"; clicked => { root.import-excel(); extras-menu.close(); } }
                                    if root.page == 1: Button { text: "Tallenna html-lähtöluettelo"; enabled: root.editable; clicked => { root.export-starts(); extras-menu.close(); } }
                                    if root.page == 5: Button { text: "+ Lisää rata"; enabled: root.editable && !root.new-record; clicked => { root.add-record(); root.details-open = true; extras-menu.close(); } }
                                    if root.page == 1: Button { text: "Lisää kilpailija"; enabled: root.editable && !root.new-record; clicked => { root.add-record(); root.details-open = true; extras-menu.close(); } }
                                    if root.page == 1: Button { text: "Arvo lähtöajat"; enabled: root.editable; clicked => { root.configure-draw-classes(); extras-menu.close(); } }
                                    if root.page == 4: Button { text: "Lisää luokka"; enabled: root.editable && !root.new-record; clicked => { root.add-record(); root.details-open = true; extras-menu.close(); } }
                                    if root.page == 4: Button { text: "Lisää yhdistetty luokka"; enabled: root.editable; clicked => { root.add-combined-class(); extras-menu.close(); } }
                                    if root.page == 4: Button { text: "Beginners Cup"; enabled: root.editable; clicked => { root.configure-bc(); extras-menu.close(); } }
                                    if root.page == 3: Button { text: "Vie tulokset"; clicked => { root.export-from-extras(); } }
                                    if root.page == 3: Button { text: "Tulosta luokkatulokset"; enabled: !root.print-busy; clicked => { root.open-print-classes(false); extras-menu.close(); } }
                                    if root.page == 3: Button { text: "Tulosta asematulokset"; enabled: !root.print-busy; clicked => { root.open-print-classes(true); extras-menu.close(); } }
                                    if root.page == 2: Button { text: "Lue kehystiedosto"; enabled: root.editable; clicked => { root.focus-page(); root.import-frame(); extras-menu.close(); } }
                                    if root.page == 3: Button { text: "Live-tulosten julkaisu"; enabled: root.editable; clicked => { root.open-publish(); extras-menu.close(); } }
                                    }
                                    FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; init => { refresh-menu.focus(); } }
                                }
                            }
                        }
                    }
                }
                if root.page == 0: overview-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width; content-height: overview-content.min-height;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    overview-content := VerticalLayout {
                    x: 0px; y: 0px;
                    width: overview-scroll.visible-width; height: self.min-height;
                    spacing: Theme.space-4;
                    if !root.opened: Rectangle {
                        height: welcome-content.min-height; vertical-stretch: 0;
                        max-width: 760px;
                        horizontal-stretch: 1;
                        background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        welcome-content := VerticalLayout {
                            padding: Theme.space-6; spacing: Theme.space-4;
                            Text { text: "Avaa kilpailu"; font-size: Theme.section-font-size; font-weight: 600; color: Theme.ink; }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Note { text: "Avaa, luo tai tuo kilpailu Toiminnot-valikosta."; }
                                Button { height: Theme.control-height; text: "Kokeile esimerkillä"; clicked => { root.open-demo(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                Button { text: root.path-open ? "Piilota polkusyöttö" : "Avaa tiedostopolulla"; clicked => { root.path-open = !root.path-open; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.path-open: Text { text: "Kilpailutiedoston tai vanhan kilpailukansion polku"; color: Theme.muted; font-size: Theme.label-font-size; }
                            if root.path-open: HorizontalLayout {
                                spacing: Theme.space-2;
                                LineEdit { text <=> root.path-input; placeholder-text: "Liitä tiedoston tai kansion polku"; accepted => { root.open-path(self.text); } }
                                Button { height: Theme.control-height; text: "Avaa polku"; clicked => { root.open-path(root.path-input); } }
                            }
                        }
                    }
                    if root.opened: Rectangle {
                        horizontal-stretch: 1;
                        height: 92px; background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        HorizontalLayout {
                            padding: Theme.panel-padding; spacing: Theme.space-6;
                            Metric { label: "Kilpailijaa"; count: root.driver-count; }
                            Metric { label: "Luokkaa"; count: root.class-count; }
                            Metric { label: "Rataa"; count: root.track-count; }
                            Metric { label: "Tallennettua lukemaa"; count: root.read-count; }
                        }
                    }
                    if root.opened: Rectangle {
                        horizontal-stretch: 1;
                        height: root.width < 1100px ? 236px : 192px;
                        background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        VerticalLayout {
                            padding: Theme.panel-padding; spacing: Theme.space-3;
                            Text { text: "Kilpailun työvaiheet"; font-size: Theme.section-font-size; font-weight: 600; color: Theme.ink; }
                            VerticalLayout {
                                spacing: Theme.space-2;
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    Button { text: "Kilpailijat"; clicked => { root.navigate(1); } }
                                    Button { text: "Radat ja asemat"; clicked => { root.navigate(5); } }
                                    if root.width >= 1100px: AccentButton { text: "Emit"; enabled: root.editable; clicked => { root.navigate(2); } }
                                    if root.width >= 1100px: Button { text: "Tulokset"; clicked => { root.navigate(3); } }
                                }
                                if root.width < 1100px: HorizontalLayout {
                                    spacing: Theme.space-2;
                                    AccentButton { text: "Emit"; enabled: root.editable; clicked => { root.navigate(2); } }
                                    Button { text: "Tulokset"; clicked => { root.navigate(3); } }
                                }
                            }
                            Note { text: "Kilpailun sijainti"; }
                            Text { text: root.competition-path; color: Theme.ink; font-size: Theme.label-font-size; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.page > 0 && root.page < 6 && !root.opened: Rectangle {
                    Text { text: "Avaa kilpailu aloittaaksesi."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.opened && root.page == 2: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-3;
                    Rectangle {
                        height: max(88px, reader-controls.min-height); vertical-stretch: 0; background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: Theme.radius;
                        reader-controls := HorizontalLayout {
                            padding: Theme.panel-padding; spacing: Theme.space-3;
                            VerticalLayout {
                                min-width: 0px; horizontal-stretch: 1; alignment: start;
                                spacing: Theme.space-1;
                                Text { text: root.reader-running ? "●  Lukija odottaa korttia" : "Kortinluku"; color: root.reader-running ? Theme.success : Theme.ink; font-size: Theme.section-font-size; font-weight: 700; }
                                Note { text: root.reader-status; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            LineEdit {
                                min-width: 160px; preferred-width: 180px; max-width: 200px; horizontal-stretch: 0; height: Theme.control-height;
                                text <=> root.reader-port;
                                placeholder-text: "Automaattinen";
                                enabled: !root.reader-running;
                            }
                            AccentButton { height: Theme.control-height; text: root.reader-running ? "Pysäytä luku" : "Käynnistä lukija"; enabled: root.editable; clicked => { if root.reader-running { root.reader-stop(); } else { root.reader-start(root.reader-port); } } }
                        }
                    }
                    if root.unsaved-count > 0: HorizontalLayout {
                        Text { text: root.unsaved-count + " lukemaa odottaa tallennusta"; color: Theme.danger; vertical-alignment: center; }
                        Button { height: Theme.control-height; text: "Päivitä ja yritä tallentaa"; enabled: !root.reader-running; clicked => { root.retry-readouts(); } }
                    }
                    Rectangle {
                        height: Theme.control-height; vertical-stretch: 0;
                        HorizontalLayout {
                            x: 0px; y: 0px; alignment: start;
                            width: reader-workspace.list-width; height: parent.height;
                            spacing: Theme.space-3;
                            Text { text: "Lukuhistoria"; horizontal-stretch: 0; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700; vertical-alignment: center; }
                            Text { text: root.read-notice-visible ? root.read-notice : ""; color: Theme.success; font-size: Theme.label-font-size; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        if !reader-workspace.compact && reader-workspace.details-visible: HorizontalLayout {
                            x: reader-workspace.details-x; width: reader-workspace.details-width; height: parent.height;
                            spacing: Theme.space-2;
                            Text { text: root.detail-title; min-width: 0px; overflow: elide; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: "Muokkaa leimauksia"; enabled: root.editable && root.selected-key >= 0; clicked => { root.open-emit-edit(); } }
                        }
                    }
                    reader-workspace := Workspace {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        show-details <=> root.details-open;
                        has-details: root.detail-rows.length > 0;
                        list-label: "Lukuhistoria"; details-label: "Kortin leimaukset";
                        preferred-details-width: 520px; maximum-details-width: 600px;
                        DataTable {
                            x: 0px; y: reader-workspace.content-y; width: reader-workspace.list-width; height: reader-workspace.content-height;
                            visible: reader-workspace.list-visible;
                            rows: root.rows; headers: root.headers; weights: root.weights;
                            selected-key: root.selected-key; empty-text: "Tallennetut korttiluvut tulevat tähän.";
                            selected(key) => { root.select-row(key); reader-workspace.show-details = true; }
                        }
                        Rectangle {
                            x: reader-workspace.details-x; y: reader-workspace.content-y;
                            width: reader-workspace.details-width; height: reader-workspace.content-height;
                            visible: reader-workspace.details-visible;
                            VerticalLayout {
                                spacing: Theme.space-2;
                                if reader-workspace.compact: HorizontalLayout {
                                    Text { text: root.detail-title; min-width: 0px; wrap: word-wrap; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 600; horizontal-stretch: 1; }
                                    Button { text: "Muokkaa leimauksia"; enabled: root.editable && root.selected-key >= 0; clicked => { root.open-emit-edit(); } }
                                }
                                DataTable { rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights; selected-key: root.detail-key; table-min-height: Theme.table-min-height; empty-text: "Valitse lukutapahtuma."; selected(key) => { root.select-detail(key); } }
                            }
                        }
                    }
                }
                if root.opened && (root.page == 1 || root.page == 3 || root.page == 4): VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-4;
                    if root.page != 3: HorizontalLayout {
                        spacing: Theme.space-3;
                        search := LineEdit { horizontal-stretch: 1; text <=> root.filter; placeholder-text: root.page == 1 ? "Hae nimellä, numerolla tai Emit-numerolla" : "Hae luettelosta"; edited => { root.filter-changed(self.text); } }
                    }
                    if root.page == 3: HorizontalLayout {
                        alignment: start; vertical-stretch: 0;
                        spacing: Theme.space-2;
                        if root.bc-configured: Button { text: "Beginners Cup"; checkable: true; checked: root.bc-results; clicked => { root.result-scope(!root.bc-results); } }
                        AccentButton { text: "Tarkista"; enabled: root.editable && root.selected-key >= 0; clicked => { root.review-results(); } }
                        Button { text: "Tutki"; enabled: root.editable && root.result-stored && root.examine-supported; clicked => { root.examine-results(); } }
                        if root.calculation-notes != "": Button { text: "Huomautukset (" + root.calculation-note-count + ")"; clicked => { root.notes-open = true; } }
                    }
                    data-workspace := Workspace {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        show-details <=> root.details-open;
                        has-details: root.page == 3 ? root.result-overview.selected : root.editor-visible;
                        details-label: root.page == 3 ? "Valitun tulos" : "Tiedot";
                        Rectangle {
                            x: 0px; y: data-workspace.content-y;
                            width: data-workspace.list-width; height: data-workspace.content-height;
                            visible: data-workspace.list-visible;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: Theme.space-4;
                            if data-workspace.compact && root.page == 3 && root.result-overview.selected: HorizontalLayout {
                                height: Theme.control-height; vertical-stretch: 0; spacing: Theme.space-2; alignment: start;
                                Button { text: "Tulosluettelo"; checkable: true; checked: !root.result-stations; clicked => { root.result-stations = false; } }
                                Button { text: "Asematulokset"; checkable: true; checked: root.result-stations; clicked => { root.result-stations = true; } }
                            }
                            DataTable {
                                horizontal-stretch: 1; vertical-stretch: 3; table-min-height: Theme.table-min-height;
                                rows: root.page == 3 && data-workspace.compact && root.result-stations ? root.detail-rows : root.rows;
                                headers: root.page == 3 && data-workspace.compact && root.result-stations ? root.detail-headers : root.headers;
                                weights: root.page == 3 && data-workspace.compact && root.result-stations ? root.detail-weights : root.weights;
                                selected-key: root.page == 3 && data-workspace.compact && root.result-stations ? root.detail-key : root.selected-key;
                                empty-text: root.filter != "" ? "Haulla ei löytynyt tietoja." : "Luettelo on tyhjä.";
                                selected(key) => {
                                    if root.page == 3 && data-workspace.compact && root.result-stations { root.select-detail(key); }
                                    else { root.select-row(key); }
                                    if root.page != 3 || root.editor-visible || root.result-overview.selected { data-workspace.show-details = true; }
                                }
                            }
                            if root.page == 3 && root.result-overview.selected && !data-workspace.compact: VerticalLayout {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                spacing: Theme.space-3;
                                HorizontalLayout {
                                    Text { text: root.detail-title; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                DataTable { horizontal-stretch: 1; vertical-stretch: 1; table-min-height: Theme.table-min-height; rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights; selected-key: root.detail-key; empty-text: "Asematuloksia ei vielä ole. Lue Emit-kortti tai tarkista kilpailijan korttiluku."; selected(key) => { root.select-detail(key); } }
                            }
                        }
                        }
                        Rectangle {
                            x: data-workspace.details-x; y: data-workspace.content-y;
                            width: data-workspace.details-width; height: data-workspace.content-height;
                            visible: data-workspace.details-visible;
                        // Tulosten oikea paneeli pysyy näkyvissä myös ennen ensimmäistä
                        // korttilukua. Sen sisältö päivittyy samasta kilpailumallista.
                        if root.page == 3 && root.result-overview.selected: result-panel := ScrollView {
                            horizontal-stretch: 0;
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: result-content.min-height;
                            horizontal-scrollbar-policy: always-off;
                            result-content := VerticalLayout {
                                x: 0px; y: 0px;
                                width: result-panel.visible-width;
                                height: self.min-height;
                                spacing: Theme.space-3;
                                ResultSummary {
                                    horizontal-stretch: 1;
                                    data: root.result-overview;
                                    editable: root.editable;
                                    approvable: root.result-approvable;
                                    interrupted: root.result-interrupted;
                                    edit-competitor => { root.edit-result-competitor(); }
                                    approve => { root.approve-results(); }
                                }
                                if root.editor-visible && root.editor-title == "Asematuloksen korjaus": Editor {
                                    details-open <=> root.competitor-details-open;
                                    driver-layout: root.editor-title == "Kilpailijan tiedot";
                                    horizontal-stretch: 1;
                                    vertical-stretch: 0;
                                    fit-content: true;
                                    heading: root.editor-title; description: root.editor-description;
                                    fields: root.fields; error: root.editor-error; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            deletable: root.page == 4 && root.editable && !root.new-record;
                            delete => { root.delete-class(); }
                                    field-commit(key, value) => { root.field-commit(key, value) }
                                    field-draft(key, value) => { root.field-draft(key, value); }
                                    add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                                }
                            }
                        }
                        if root.page != 3 && root.editor-visible: Editor {
                            width: parent.width; height: parent.height;
                            details-open <=> root.competitor-details-open;
                            driver-layout: root.editor-title == "Kilpailijan tiedot";
                            horizontal-stretch: 0;
                            heading: root.editor-title; description: root.editor-description;
                            fields: root.fields; error: root.editor-error; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            deletable: root.page == 4 && root.editable && !root.new-record;
                            delete => { root.delete-class(); }
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                        }
                        }
                    }
                }
                // Sama luettelo vasemmalla / tiedot oikealla -rakenne kuin muilla sivuilla.
                if root.opened && root.page == 5: VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    spacing: Theme.space-3;
                    HorizontalLayout {
                        vertical-stretch: 0;
                        height: Theme.control-height;
                        spacing: Theme.space-3;
                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.filter;
                            placeholder-text: "Hae radoista";
                            edited => { root.filter-changed(self.text); }
                        }

                    }
                    route-workspace := Workspace {
                        property <length> route-panel-height: min(210px, max(160px, min(194px, Theme.control-height + root.rows.length * Theme.row-height) + Theme.scrollbar-width + 2px));
                        horizontal-stretch: 1; vertical-stretch: 1;
                        show-details <=> root.details-open;
                        has-details: root.route-editor-visible || root.editor-visible;
                        list-label: "Radat ja asemat";
                        Rectangle {
                            x: 0px; y: route-workspace.content-y; width: route-workspace.list-width; height: route-workspace.content-height;
                            visible: route-workspace.list-visible;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-2;
                            if route-workspace.compact: Rectangle {
                                height: Theme.control-height; vertical-stretch: 0;
                                Button { width: parent.width; height: parent.height;
                                text: root.route-fields.length > 0 ? "Rata: " + root.route-fields[0].value : "Valitse rata";
                                clicked => { route-menu.show(); }
                                }
                                route-menu := PopupWindow {
                                    y: Theme.control-height + Theme.space-2;
                                    width: min(560px, route-workspace.list-width);
                                    height: min(350px, max(100px, Theme.control-height + root.rows.length * Theme.row-height + Theme.scrollbar-width + 2px));
                                    DataTable {
                                        rows: root.rows; headers: root.headers; weights: root.weights;
                                        selected-key: root.selected-key;
                                        selected(key) => { root.select-row(key); route-menu.close(); route-details.content-y = 0px; }
                                    }
                                }
                            }
                            if !route-workspace.compact: Text { text: "Radat"; height: 22px; vertical-stretch: 0; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700; }
                            if !route-workspace.compact: DataTable {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                table-min-height: 84px;
                                // Taulukko varaa myös vaakavierityspalkin kaistan ja reunukset.
                                preferred-height: route-workspace.route-panel-height;
                                max-height: 210px;
                                rows: root.rows; headers: root.headers; weights: root.weights;
                                selected-key: root.selected-key;
                                empty-text: root.filter != "" ? "Haulla ei löytynyt ratoja." : "Ei vielä ratoja. Lisää ensimmäinen rata.";
                                selected(key) => { root.select-row(key); route-details.content-y = 0px; }
                            }
                            HorizontalLayout {
                                vertical-stretch: 0;
                                height: Theme.control-height;
                                spacing: Theme.space-2;
                                Text {
                                    text: "Asemat";
                                    accessible-label: root.detail-title;
                                    min-width: 0px;
                                    color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    height: Theme.control-height; text: "+ Asema";
                                    enabled: root.editable && root.selected-key >= 0 && !root.new-record;
                                    clicked => { root.add-station(); route-workspace.show-details = true; }
                                }
                                Button {
                                    height: Theme.control-height; min-width: Theme.control-height; max-width: Theme.control-height; text: "↑";
                                    accessible-label: "Siirrä asemaa ylöspäin";
                                    enabled: root.editable && root.detail-key > 0 && !root.new-record;
                                    clicked => { root.move-station(-1); }
                                }
                                Button {
                                    height: Theme.control-height; min-width: Theme.control-height; max-width: Theme.control-height; text: "↓";
                                    accessible-label: "Siirrä asemaa alaspäin";
                                    enabled: root.editable && root.detail-key >= 0 && !root.new-record;
                                    clicked => { root.move-station(1); }
                                }
                            }
                            DataTable {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                table-min-height: Theme.table-min-height;
                                rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights;
                                selected-key: root.detail-key;
                                empty-text: "Valitse rata yllä olevasta luettelosta.";
                                selected(key) => { root.select-detail(key); route-workspace.show-details = true; route-details.content-y = 0px; }
                            }
                        }
                        }
                        route-details := ScrollView {
                            x: route-workspace.details-x;
                            y: route-workspace.content-y + (route-workspace.compact ? 0px : 22px + Theme.space-2);
                            width: route-workspace.details-width;
                            height: route-workspace.content-height - (route-workspace.compact ? 0px : 22px + Theme.space-2);
                            visible: route-workspace.details-visible;
                            horizontal-scrollbar-policy: always-off;
                            content-width: self.visible-width; content-height: route-content.min-height;
                        route-content := VerticalLayout {
                            x: 0px; y: 0px; width: route-details.visible-width; height: self.min-height;
                            spacing: Theme.space-3;
                            if route-workspace.compact && root.editor-visible && (root.editor-title == "Aseman tiedot" || root.editor-title == "Uusi asema"): HorizontalLayout {
                                height: Theme.control-height; vertical-stretch: 0; spacing: Theme.space-2; alignment: start;
                                Button { text: "Radan tiedot"; checkable: true; checked: !root.station-editor-focused; clicked => { root.station-editor-focused = false; route-details.content-y = 0px; } }
                                Button { text: "Aseman tiedot"; checkable: true; checked: root.station-editor-focused; clicked => { root.station-editor-focused = true; route-details.content-y = 0px; } }
                            }
                            if root.route-editor-visible && (!route-workspace.compact || !root.station-editor-focused): Editor {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                fit-content: true;
                                min-height: route-workspace.compact ? self.preferred-height : max(self.preferred-height, route-workspace.route-panel-height);
                                heading: "Radan tiedot";
                                description: "";
                                fields: root.route-fields; writable: root.editable;
                                field-commit(key, value) => { root.route-field-commit(key, value) }
                                field-draft(key, value) => { root.route-field-draft(key, value); }
                            }
                            if root.editor-visible && root.editor-title == "Uusi rata": Editor {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                fit-content: true;
                                heading: root.editor-title; description: root.editor-description;
                                fields: root.fields; error: root.editor-error; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            deletable: root.page == 4 && root.editable && !root.new-record;
                            delete => { root.delete-class(); }
                                field-commit(key, value) => { root.field-commit(key, value) }
                                field-draft(key, value) => { root.field-draft(key, value); }
                                add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                            }
                            if root.editor-visible && (root.editor-title == "Aseman tiedot" || root.editor-title == "Uusi asema") && (!route-workspace.compact || root.station-editor-focused): Editor {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                fit-content: true;
                                station-layout: route-workspace.compact;
                                record-key: root.selected-key + "/" + root.detail-key;
                                heading: root.editor-title; description: root.editor-description;
                                fields: root.fields; error: root.editor-error; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            deletable: root.page == 4 && root.editable && !root.new-record;
                            delete => { root.delete-class(); }
                                field-commit(key, value) => { root.field-commit(key, value) }
                                field-draft(key, value) => { root.field-draft(key, value); }
                                add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                            }
                        }
                        }
                    }
                }
                if root.page == 6: settings-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width; content-height: settings-content.height;
                    settings-content := Rectangle {
                        x: 0px; y: 0px;
                        width: min(Theme.settings-max-width, settings-scroll.visible-width);
                        property <bool> compact: self.width < 1100px;
                        height: self.compact && root.opened ? settings-editor.min-height + Theme.space-4 + storage-content.min-height : max(root.opened ? settings-editor.min-height : 0px, storage-content.min-height);
                        settings-editor := Editor {
                            x: 0px; y: 0px;
                            visible: root.opened;
                            // Constrained by the parent layout; no window-size feedback.
                            width: settings-content.compact ? settings-content.width : settings-content.width - 360px - Theme.space-4;
                            height: settings-content.compact ? self.min-height : settings-content.height;
                            heading: "Kilpailun asetukset"; description: "";
                            fit-content: true;
                            columns: self.width >= 980px ? 3 : self.width >= 620px ? 2 : 1;
                            fields: root.fields; error: root.editor-error; writable: root.editable && !root.install-busy; blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            cancel => { root.cancel-edit(); }
                        }
                            Rectangle {
                                x: settings-content.compact || !root.opened ? 0px : settings-editor.width + Theme.space-4;
                                y: settings-content.compact && root.opened ? settings-editor.height + Theme.space-4 : 0px;
                                width: settings-content.compact || !root.opened ? settings-content.width : settings-content.width - settings-editor.width - Theme.space-4;
                                height: settings-content.compact ? storage-content.min-height : settings-content.height; background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                                storage-content := VerticalLayout {
                                    x: 0px; y: 0px; width: parent.width; height: self.min-height; alignment: start;
                                    padding: Theme.panel-padding; spacing: Theme.space-3;
                                    if root.opened: Button { text: "Valitse lähtöluettelon kentät ja järjestys"; enabled: root.editable; clicked => { root.configure-start-columns(); } }
                                    Text { text: "Kilpailujen tallennuspaikka"; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700; }
                                    Note { text: "Uusi kilpailu tallennetaan omaan kansioonsa tämän sijainnin alle."; }
                                    Text { text: root.default-root; color: Theme.ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: Theme.space-3;
                                        Button { height: Theme.control-height; text: "Vaihda sijaintia"; clicked => { root.change-default-root(); } }
                                        Button { height: Theme.control-height; text: "Palauta oletus"; clicked => { root.reset-default-root(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Note { text: "Sijainnin vaihtaminen koskee uusia kilpailuja. Aiemmat kilpailut säilyvät paikoillaan."; }
                                    Text { text: "Tulostin"; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 700; }
                                    ComboBox { model: root.printers; current-index <=> root.printer-index; selected => { root.select-printer(self.current-index); } }
                                    Button { text: "Päivitä tulostinluettelo"; clicked => { root.refresh-printers(); } }
                                    Note { text: "Valinta koskee kilpailijaparin tulosta sekä luokka- ja asematuloksia. Tyhjä oletus käyttää käyttöjärjestelmän oletustulostinta."; }
                                }
                            }
                    }
                }
            }
            Rectangle {
                height: Theme.control-height + Theme.space-2;
                background: root.status-error ? Theme.danger-soft : Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.gutter; padding-right: Theme.gutter; padding-top: Theme.space-1; padding-bottom: Theme.space-1; spacing: Theme.space-3;
                    Text { text: root.status-error || root.form-blocked ? "!" : root.editor-error != "" ? "i" : root.editable && root.opened ? "✓" : "i"; color: root.status-error ? Theme.danger : root.form-blocked ? Theme.warning : Theme.accent; font-weight: 700; width: 14px; vertical-alignment: center; }
                    Text { text: root.status-summary; color: root.status-error ? Theme.danger : Theme.muted; font-size: Theme.label-font-size; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; }
                }
            }
        }
    }
    if root.competitor-edit-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            width: parent.width; height: parent.height;
            init => { competitor-close.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.edit-result-competitor(); return accept; }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-width: 960px; preferred-dialog-height: 820px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-3;
                    Heading { text: "Muokkaa kilpailijaa"; }
                    competitor-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width; content-height: competitor-editor.min-height;
                        competitor-editor := Editor {
                            width: competitor-scroll.visible-width;
                            fit-content: true;
                            columns: self.width >= 720px ? 2 : 1;
                            heading: root.editor-title; fields: root.fields;
                            error: root.editor-error; writable: root.editable;
                            blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                    }
                    DialogActions { competitor-close := Button { text: "Valmis"; clicked => { root.edit-result-competitor(); } } }
                }
            }
        }
    }
    if root.lan-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            width: parent.width; height: parent.height; focus-on-tab-navigation: false;
            property <bool> joined: root.lan-active;
            changed joined => { lan-close.focus(); }
            init => { lan-close.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { if !root.lan-busy { root.lan-open = false; } return accept; }
                if event.text == Key.Tab {
                    if root.lan-busy { lan-close.focus(); return accept; }
                    if root.lan-active {
                        if lan-close.has-focus && event.modifiers.shift { lan-disconnect.focus(); return accept; }
                        if lan-disconnect.has-focus && !event.modifiers.shift { lan-close.focus(); return accept; }
                    } else {
                        if event.modifiers.shift && (lan-share.has-focus || (!lan-share.enabled && lan-find.has-focus)) {
                            if lan-connect.enabled { lan-connect.focus(); } else { lan-close.focus(); }
                            return accept;
                        }
                        if !event.modifiers.shift && (lan-connect.has-focus || (lan-close.has-focus && !lan-connect.enabled)) {
                            if lan-share.enabled { lan-share.focus(); } else { lan-find.focus(); }
                            return accept;
                        }
                    }
                }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-width: 560px; preferred-dialog-height: root.lan-active ? 360px : 420px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-3;
                    Heading { text: "Kilpailu lähiverkossa"; }
                    lan-dialog-scroll := ScrollView {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width; content-height: lan-dialog-body.min-height;
                        lan-dialog-body := VerticalLayout {
                            width: lan-dialog-scroll.visible-width; height: self.min-height;
                            spacing: Theme.space-3; alignment: start;
                            Note { text: root.lan-active ? root.lan-status : "Avaa kilpailu isäntäkoneessa. Muut koneet liittyvät sen parituskoodilla."; }
                            if root.lan-hosting: Rectangle {
                                height: 112px; vertical-stretch: 0;
                                background: Theme.surface-raised; border-radius: Theme.radius;
                                VerticalLayout {
                                    padding: Theme.panel-padding; spacing: Theme.space-2;
                                    Text { text: "Parituskoodi"; color: Theme.muted; font-size: Theme.label-font-size; }
                                    Text { text: root.lan-code; color: Theme.ink; font-size: 26px; font-weight: 700; letter-spacing: 2px; }
                                    Text { text: "Isäntäosoite  " + root.lan-host-address; color: Theme.muted; font-size: Theme.body-font-size; }
                                }
                            }
                            Rectangle {
                                visible: !root.lan-active; min-height: root.lan-active ? 0px : Theme.control-height; max-height: root.lan-active ? 0px : Theme.control-height; vertical-stretch: 0; clip: true;
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    lan-share := AccentButton { text: "Jaa tämä kilpailu"; enabled: root.editable && !root.lan-busy; clicked => { root.lan-host(); } }
                                    lan-find := Button { text: "Etsi lähiverkosta"; enabled: !root.lan-busy; clicked => { root.lan-discover(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            if !root.lan-active: Text { text: "Isäntäkoneen IP-osoite"; color: Theme.muted; font-size: Theme.label-font-size; }
                            if !root.lan-active: LineEdit { text <=> root.lan-address; placeholder-text: "192.168.1.20"; enabled: !root.lan-busy; accepted => { if lan-connect.enabled { root.lan-join(); } } }
                            if !root.lan-active: Text { text: "Parituskoodi"; color: Theme.muted; font-size: Theme.label-font-size; }
                            if !root.lan-active: LineEdit { text <=> root.lan-code; enabled: !root.lan-busy; accepted => { if lan-connect.enabled { root.lan-join(); } } }
                            if root.lan-info != "": Text { text: root.lan-info; color: Theme.ink; wrap: word-wrap; min-height: 40px; }
                            if root.lan-error != "": Text { text: root.lan-error; color: Theme.danger; wrap: word-wrap; }
                        }
                    }
                    DialogActions {
                        lan-close := Button { text: "Sulje"; enabled: !root.lan-busy; clicked => { root.lan-open = false; } }
                        lan-disconnect := Button { visible: root.lan-active; min-width: root.lan-active ? 76px : 0px; max-width: root.lan-active ? 10000px : 0px; text: root.lan-hosting ? "Lopeta jakaminen" : "Katkaise yhteys"; enabled: !root.lan-busy; clicked => { root.lan-leave(); } }
                        lan-connect := AccentButton { visible: !root.lan-active; min-width: root.lan-active ? 0px : 76px; max-width: root.lan-active ? 0px : 10000px; text: "Yhdistä kilpailuun"; enabled: !root.lan-busy && root.lan-address != "" && root.lan-code != ""; clicked => { root.lan-join(); } }
                    }
                }
            }
        }
    }
    if root.export-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            init => { export-save.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.export-open = false; return accept; }
                if event.text == Key.Tab {
                    if export-save.has-focus && !event.modifiers.shift { export-path-field.focus(); return accept; }
                    if export-path-field.has-focus && event.modifiers.shift { export-save.focus(); return accept; }
                }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-width: 760px; preferred-dialog-height: 340px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-3;
                    Heading { text: "Vie tulokset · " + root.export-label; }
                    Text { text: "Tiedosto"; color: Theme.muted; font-size: Theme.label-font-size; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        export-path-field := LineEdit { text <=> root.export-path; horizontal-stretch: 1; accessible-label: "Tulostiedosto"; edited => { root.export-error = ""; } accepted => { root.save-export(); } }
                        Button { text: "Selaa"; clicked => { root.browse-export(); } }
                    }
                    if root.export-error != "": Text { text: root.export-error; color: Theme.danger; wrap: word-wrap; }
                    Note { text: "Vain hyväksytyt tulokset saavat sijoituksen ja pisteet."; }
                    Rectangle { vertical-stretch: 1; }
                    DialogActions {
                        Button { text: "Peruuta"; clicked => { root.export-open = false; } }
                        export-save := AccentButton { text: "Tallenna"; enabled: root.export-path != ""; clicked => { root.save-export(); } }
                    }
                }
            }
        }
    }
    if root.notes-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            focus-on-tab-navigation: false;
            init => { notes-close.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.notes-open = false; return accept; }
                if event.text == Key.Tab {
                    if notes-close.has-focus && !event.modifiers.shift { notes-toggle.focus(); return accept; }
                    if notes-toggle.has-focus && event.modifiers.shift { notes-close.focus(); return accept; }
                }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-width: 760px; preferred-dialog-height: 560px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-4;
                    Heading { text: "Tulosten huomautukset"; vertical-stretch: 0; }
                    notes-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width; content-height: notes-text.preferred-height;
                        notes-text := Note { width: notes-scroll.visible-width; height: self.preferred-height; text: root.note-details-open ? root.calculation-note-details : (root.calculation-notes != "" ? root.calculation-notes : "Ei huomautuksia."); }
                    }
                    HorizontalLayout { alignment: start; notes-toggle := Button { text: root.note-details-open ? "Näytä yhteenveto" : "Näytä lisätiedot"; clicked => { root.note-details-open = !root.note-details-open; } } }
                    DialogActions { notes-close := Button { text: "Sulje"; clicked => { root.notes-open = false; } } }
                }
            }
        }
    }
    if root.dialog-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { dialog-name.focus(); }
        // Pidä tabulaattorikierto avoimessa valintaikkunassa.
        capture-key-pressed(event) => {
            if event.text == Key.Tab {
                if event.modifiers.shift {
                    if dialog-name.has-focus { dialog-create.focus(); }
                    else if dialog-path.has-focus { dialog-name.focus(); }
                    else if dialog-browse.has-focus { dialog-path.focus(); }
                    else if dialog-location.has-focus { if root.new-location-visible { dialog-browse.focus(); } else { dialog-name.focus(); } }
                    else if dialog-cancel.has-focus { dialog-location.focus(); }
                    else { dialog-cancel.focus(); }
                } else {
                    if dialog-name.has-focus { if root.new-location-visible { dialog-path.focus(); } else { dialog-location.focus(); } }
                    else if dialog-path.has-focus { dialog-browse.focus(); }
                    else if dialog-browse.has-focus { dialog-location.focus(); }
                    else if dialog-location.has-focus { dialog-cancel.focus(); }
                    else if dialog-cancel.has-focus { dialog-create.focus(); }
                    else { dialog-name.focus(); }
                }
                return accept;
            }
            reject
        }
        DialogSurface {
                available-width: root.width; available-height: root.height;
            preferred-dialog-height: root.new-location-visible ? 460px : 360px;
            VerticalLayout {
                padding: Theme.dialog-padding; spacing: Theme.space-4;
                Heading { text: "Uusi kilpailu"; }
                new-scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: new-content.min-height;
                new-content := VerticalLayout {
                x: 0px; y: 0px; width: new-scroll.visible-width; height: self.min-height;
                spacing: Theme.space-3;
                VerticalLayout {
                    spacing: Theme.space-1;
                    Text { text: "Kilpailun nimi"; color: Theme.ink; font-size: Theme.label-font-size; font-weight: 600; }
                    dialog-name := LineEdit {
                        text <=> root.new-name; placeholder-text: "Esimerkiksi Syysajo 2026";
                        accessible-label: "Kilpailun nimi";
                        accepted => { root.create-project(root.new-path, root.new-name); }
                    }
                    if root.new-error != "": Text { text: root.new-error; color: Theme.danger; font-size: Theme.label-font-size; wrap: word-wrap; }
                }
                VerticalLayout {
                    spacing: Theme.space-1;
                    visible: root.new-location-visible;
                    height: root.new-location-visible ? 65px : 0px;
                    Text { text: "Tallennuspaikka"; color: Theme.ink; font-size: Theme.label-font-size; font-weight: 600; }
                    HorizontalLayout {
                        dialog-path := LineEdit {
                            text <=> root.new-path; placeholder-text: "Valitse kansio tai anna uuden kansion polku";
                            accessible-label: "Kilpailun kansio";
                            accepted => { root.create-project(root.new-path, root.new-name); }
                        }
                        dialog-browse := Button { height: Theme.control-height; text: "Selaa"; clicked => { root.browse-new-path(); } }
                    }
                }
                Note { text: "Sijainti: " + (root.new-path == "" ? root.default-root : root.new-path); }
                dialog-location := Button { height: Theme.control-height; text: "Vaihda sijaintia"; clicked => { root.new-location-visible = true; root.browse-new-path(); } }
                }
                }
                DialogActions {
                    dialog-cancel := Button { height: Theme.control-height; text: "Peruuta"; clicked => { root.dialog-open = false; } }
                    dialog-create := AccentButton { height: Theme.control-height; text: "Luo kilpailu"; clicked => { root.create-project(root.new-path, root.new-name); } }
                }
            }
        }
        }
    }
    if root.about-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { about-close.focus(); }
            capture-key-pressed(event) => {
                if !event.modifiers.control && !event.modifiers.alt && !root.tung-active {
                    if event.text == "t" { root.tung-keys = "t"; }
                    else if event.text == "u" && root.tung-keys == "t" { root.tung-keys = "tu"; }
                    else if event.text == "n" && root.tung-keys == "tu" { root.tung-keys = "tun"; }
                    else if event.text == "g" && root.tung-keys == "tun" {
                        root.tung-keys = "";
                        root.tung-frame = 0;
                        root.tung-start();
                    } else { root.tung-keys = ""; }
                }
                if event.text == Key.Tab {
                    if event.modifiers.shift {
                        if about-close.has-focus { about-effects.focus(); }
                        else if about-effects.has-focus { about-appearance.focus(); }
                        else { about-close.focus(); }
                    } else {
                        if about-close.has-focus { about-appearance.focus(); }
                        else if about-appearance.has-focus { about-effects.focus(); }
                        else { about-close.focus(); }
                    }
                    return accept;
                }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-height: 480px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-4;
                    Heading { text: "Tietoja AS2026:sta"; }
                    about-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: about-content.min-height;
                    about-content := VerticalLayout {
                    x: 0px; y: 0px; width: about-scroll.visible-width; height: self.min-height;
                    spacing: Theme.space-3;
                    Note { text: "Versio " + root.app-version + " · autosuunnistuksen kilpailunhallinta"; }
                    Text { text: "AS2026:n oma koodi: BSD-2-Clause-lisenssi"; color: Theme.ink; font-size: Theme.body-font-size; }
                    Note { text: "Käyttö, muokkaus ja jakelu on sallittu lisenssin ehdoin. Tekijänoikeusilmoitus ja lisenssiehdot säilytetään jaettaessa. Ei takuuta."; }
                    AboutSlint { horizontal-stretch: 1; height: 170px; }
                    Rectangle { height: Theme.space-3; }
                    Text { text: "Ulkoasu"; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 600; }
                    about-appearance := ComboBox {
                        model: ["Järjestelmän mukaan", "Vaalea", "Tumma", "Dark Spruce"];
                        current-index <=> root.appearance-index;
                        accessible-label: "Sovelluksen ulkoasu";
                        selected(value) => { root.set-appearance(self.current-index); }
                    }
                    Text { text: "Ulkoasutehosteet"; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 600; }
                    about-effects := CheckBox {
                        text: "Ota animaatiot ja tehosteet käyttöön";
                        checked <=> root.effects-enabled;
                        toggled => { root.set-effects-enabled(self.checked); }
                    }
                    Note { text: "Oletus on pois käytöstä. Valinta ohjaa kaikkia betan valinnaisia animaatioita ja tehosteita. Sumennus ja muut uudet tehosteet lisätään vasta niiden toteutuksen ja testauksen jälkeen."; }
                    }
                    }
                    DialogActions { about-close := Button { text: "Sulje"; clicked => { root.about-open = false; } } }
                }
            }
        }
    }
    if root.setup-open || root.install-busy: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { setup-install.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Tab {
                if !root.install-busy && setup-install.has-focus { setup-later.focus(); }
                else { setup-install.focus(); }
                return accept;
            }
            reject
        }
        DialogSurface {
                available-width: root.width; available-height: root.height;
            preferred-dialog-height: 300px;
            VerticalLayout {
                padding: Theme.dialog-padding; spacing: Theme.space-4;
                Heading { text: root.install-busy ? "Asennetaan AS2026:ta" : "Asenna AS2026"; }
                setup-scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: setup-content.min-height;
                setup-content := VerticalLayout {
                x: 0px; y: 0px; width: setup-scroll.visible-width; height: self.min-height;
                spacing: Theme.space-3;
                Note { text: root.install-busy ? "Ohjelma avautuu automaattisesti asennuksen valmistuttua." : "Asennus lisää AS2026:n sovellusvalikkoon ja mahdollistaa päivitykset sivupalkista."; }
                Note { text: "Kilpailut ja asetukset säilyvät erillään ohjelmatiedostoista."; }
                }
                }
                DialogActions {
                    setup-later := Button { visible: !root.install-busy; enabled: !root.install-busy; text: "Myöhemmin"; clicked => { root.setup-open = false; } }
                    setup-install := AccentButton { height: Theme.control-height; text: root.install-busy ? "Odota" : "Asenna ja käynnistä"; enabled: !root.install-busy; clicked => { root.install-app(); } }
                }
            }
        }
        }
    }
    }
    // Sama läpinäkymätön Fluent-pinta myös pisteiden ja arvonnan vahvistuksille.
    if root.confirm-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { confirm-cancel.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.confirm-action(false); return accept; }
                if event.text == Key.Tab && !root.import-open {
                    if !root.confirm-acceptable { confirm-cancel.focus(); }
                    else if confirm-cancel.has-focus { confirm-accept.focus(); }
                    else { confirm-cancel.focus(); }
                    return accept;
                }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-width: root.import-open ? Theme.dialog-wide-width : Theme.dialog-width;
                preferred-dialog-height: root.import-open ? 860px : 440px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-4;
                    Heading { text: root.confirm-title; }
                    if !root.import-open: confirm-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: confirm-note.preferred-height;
                        confirm-note := Note { x: 0px; y: 0px; width: confirm-scroll.visible-width; height: self.preferred-height; text: root.confirm-text; }
                    }
                    if root.import-open: import-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: import-content.min-height;
                        import-content := VerticalLayout {
                            x: 0px; y: 0px; width: import-scroll.visible-width; height: self.min-height;
                            spacing: Theme.space-3;
                            Note { text: root.confirm-text; }
                            if root.import-mode != 1: Note { text: "Radat voi valita myös tuonnin jälkeen Luokat-sivulla."; }
                            Text { text: "Kilpailun nimi"; color: Theme.ink; }
                            LineEdit { text <=> root.import-name; placeholder-text: "Kilpailun nimi"; }
                            if root.import-error != "": Text { text: root.import-error; color: Theme.danger; wrap: word-wrap; }
                            Button { text: root.import-location-open ? "Piilota tallennuspaikka" : "Tallennuspaikka"; clicked => { root.import-location-open = !root.import-location-open; } }
                            if root.import-location-open: HorizontalLayout {
                                spacing: Theme.space-2;
                                Note { text: root.import-root; horizontal-stretch: 1; }
                                Button { text: "Vaihda sijaintia"; clicked => { root.browse-import-root(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Tuotavat tiedot"; color: Theme.ink; vertical-alignment: center; }
                                ComboBox { model: ["Koko kilpailu", "Tuo vain radat", "Tuo vain kilpailijat"]; current-index: root.import-mode; selected(value) => { root.import-selection(self.current-index); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.import-mode == 0 && root.import-routes.length > 1: Button { text: root.import-mapping-open ? "Piilota ratavalinnat" : "Luokkien ratavalinnat"; clicked => { root.import-mapping-open = !root.import-mapping-open; } }
                            if root.import-mapping-open && root.import-mode == 0 && root.import-routes.length > 1: VerticalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Luokkien radat"; color: Theme.ink; font-weight: 600; }
                                for code[index] in root.import-classes: HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Text { text: code; color: Theme.ink; width: 160px; vertical-alignment: center; }
                                    ComboBox { model: root.import-routes; current-index: root.import-route-choices[index]; selected(value) => { root.import-class-route(code, value); } }
                                }
                            }
                            if root.import-mode == 0: HorizontalLayout {
                                spacing: Theme.space-2;
                                Button { text: "Kilpailijat"; checkable: true; checked: root.import-tab == 0; clicked => { root.import-tab = 0; } }
                                Button { text: "Radat ja asemat"; checkable: true; checked: root.import-tab == 1; clicked => { root.import-tab = 1; } }
                            }
                            DataTable { height: 230px; rows: root.import-tab == 0 ? root.import-rows : root.import-station-rows; headers: root.import-tab == 0 ? ["Nro", "Luokka", "Kuljettaja", "Kartanlukija", "Emit", "Lähtö"] : ["Rata", "Järj.", "Asema", "Tyyppi", "Emit", "Tavoite, s"]; weights: [0.7, 1, 1.7, 1.7, 1, 1]; }
                            if root.import-details != "": Button { text: root.import-details-open ? "Piilota huomautukset" : "Näytä huomautukset"; clicked => { root.import-details-open = !root.import-details-open; } }
                            if root.import-details-open: Note { text: root.import-details; }
                        }
                    }
                    DialogActions {
                        confirm-cancel := Button { height: Theme.control-height; text: "Peruuta"; clicked => { root.confirm-action(false); } }
                        confirm-accept := AccentButton { height: Theme.control-height; text: root.import-open ? (root.import-mode == 1 ? "Tuo radat" : root.import-mode == 2 ? "Tuo kilpailijat" : "Tuo kilpailu") : root.confirm-action-label; enabled: root.confirm-acceptable; clicked => { root.confirm-action(true); } }
                    }
                }
            }
        }
    }
    if root.status-details-open: Rectangle {
        background: Theme.modal-backdrop;
        TouchArea { }
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { status-close.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.status-details-open = false; return accept; }
                if event.text == Key.Tab { status-close.focus(); return accept; }
                reject
            }
            DialogSurface {
                available-width: root.width; available-height: root.height;
                preferred-dialog-height: 320px;
                VerticalLayout {
                    padding: Theme.dialog-padding; spacing: Theme.space-4;
                    Heading { text: "Toiminnon tiedot"; }
                    status-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: status-note.preferred-height;
                        status-note := Note { x: 0px; y: 0px; width: status-scroll.visible-width; height: self.preferred-height; text: root.status-text; }
                    }
                    DialogActions { status-close := Button { text: "Sulje"; clicked => { root.status-details-open = false; } } }
                }
            }
        }
    }
    if root.start-columns-open: StartColumnsDialog {
        width: root.width; height: root.height;
        columns: root.start-columns; error: root.start-columns-error;
        toggle(index, selected) => { root.start-column-toggled(index, selected); }
        move(index, delta) => { root.move-start-column(index, delta); }
        close(accepted) => { root.start-columns-close(accepted); }
    }
    if root.draw-classes-open: DrawClassDialog {
        classes: root.draw-classes;
        summary: root.draw-class-summary;
        toggle(index, selected) => { root.draw-class-toggled(index, selected); }
        select-all(selected) => { root.draw-classes-all(selected); }
        close(accepted) => { root.draw-classes-close(accepted); }
    }
    if root.combined-open: CombinedClassDialog {
        width: root.width; height: root.height;
        creating: root.combined-creating;
        name <=> root.combined-name;
        classes: root.combined-classes;
        np <=> root.combined-np;
        sp <=> root.combined-sp;
        error: root.combined-error;
        toggle(index, selected) => { root.combined-class-toggled(index, selected); }
        close(accepted) => { root.combined-close(accepted); }
    }
    if root.bc-open: BeginnersCupDialog {
        width: root.width; height: root.height;
        name <=> root.bc-name; code <=> root.bc-code;
        routes: root.bc-routes; route <=> root.bc-route;
        stations: root.bc-stations; participants: root.bc-participants;
        error: root.bc-error;
        route-selected(index) => { root.bc-route-selected(index); }
        station-toggled(index, selected) => { root.bc-station-toggled(index, selected); }
        participant-toggled(index, selected) => { root.bc-participant-toggled(index, selected); }
        close(accepted) => { root.bc-close(accepted); }
    }
    if root.emit-edit-open: EmitCorrectionDialog {
        width: root.width; height: root.height;
        identity: root.emit-edit-identity; fields: root.emit-edit-fields;
        error: root.emit-edit-error; history: root.emit-edit-history;
        edited(key, value) => { root.emit-edit-edited(key, value); }
        add(restore) => { root.emit-edit-add(restore); }
        close(save) => { root.emit-edit-close(save); }
    }
    if root.publish-open: LivePublishDialog {
        width: root.width; height: root.height;
        fields: root.publish-fields; status: root.publish-status; classes: root.publish-classes;
        class-toggled(index,selected) => { root.publish-class-toggled(index,selected); }
        local => { root.publish-local(); }
        running: root.publish-running; busy: root.publish-busy;
        protocol <=> root.publish-protocol;
        edited(key, value) => { root.publish-edited(key, value); }
        test => { root.publish-test(); }
        toggle => { root.publish-toggle(); }
        finish => { root.publish-finish(); }
        close => { root.publish-open = false; }
    }
    if root.result-entry-open: ResultEntryDialog {
        width: root.width; height: root.height;
        queued: root.result-entry-queue;
        identity: root.result-entry-identity; fields: root.result-entry-fields;
        error: root.result-entry-error; focus-index <=> root.result-entry-focus;
        edited(key, value) => { root.result-entry-edited(key, value); }
        close(accepted) => { root.result-entry-close(accepted); }
        save => { root.result-entry-save(); }
    }
    if root.print-classes-open: PrintClassesDialog {
        width: root.width; height: root.height;
        stations: root.print-stations; classes: root.print-classes;
        landscape <=> root.print-landscape; fit <=> root.print-fit;
        printer: root.printer-name; error: root.print-error;
        toggle(index, selected) => { root.print-class-toggled(index, selected); }
        select-all(selected) => { root.print-classes-all(selected); }
        close(accepted) => { root.print-classes-close(accepted); }
    }
    // Paikallinen yllätys: sama kuva 16 kertaa, kukin omalla pyörimisnopeudella.
    if root.effects-enabled && root.tung-active: Rectangle {
        width: root.width; height: root.height;
        background: transparent;
        for speed[index] in root.tung-speeds: Image {
            width: min(root.width, root.height) * (0.045 + Math.pow(Math.mod(index * 7, 16) / 15, 2) * 0.905);
            height: self.width;
            x: (Math.mod(index, 4) + 0.5) * root.width / 4 - self.width / 2;
            y: (Math.floor(index / 4) + 0.5) * root.height / 4 - self.height / 2;
            source: @image-url("assets/tung.png");
            image-fit: contain;
            transform-rotation: root.tung-frame * speed * 0.048deg;
        }
    }


}
