import { Button, LineEdit, Palette, AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow, EditorField } from "types.slint";
import { Heading, Note, NavItem, DataTable, Editor, Metric } from "components.slint";
export { TableRow, EditorField }

export component AppWindow inherits Window {
    init => { Palette.color-scheme = Theme.color-scheme; }
    title: "AS2026 — kilpailunhallinta";
    preferred-width: 1320px; preferred-height: 860px;
    min-width: 480px; min-height: 320px;
    background: Theme.canvas;
    default-font-size: Theme.body-font-size;
    forward-focus: keyboard;
    in-out property <int> page: 0;
    in-out property <bool> opened;
    in-out property <bool> editable;
    in-out property <bool> demo;
    in-out property <string> competition-name: "Ei avointa kilpailua";
    in-out property <string> competition-path;
    in-out property <string> status-text: "Avaa kilpailu tai perusta uusi.";
    in-out property <bool> status-error;
    in-out property <int> driver-count;
    in-out property <int> class-count;
    in-out property <int> track-count;
    in-out property <int> read-count;
    in-out property <int> unsaved-count;
    in-out property <string> filter;
    in-out property <[TableRow]> rows;
    in-out property <[string]> headers;
    in-out property <[float]> weights;
    in-out property <int> selected-key: -1;
    in-out property <[TableRow]> detail-rows;
    in-out property <[string]> detail-headers;
    in-out property <[float]> detail-weights;
    in-out property <int> detail-key: -1;
    in-out property <string> detail-title;
    in-out property <bool> editor-visible;
    in-out property <bool> new-record;
    in-out property <bool> form-blocked;
    in-out property <string> editor-title;
    in-out property <string> editor-description;
    in-out property <[EditorField]> fields;
    in-out property <bool> reader-running;
    in-out property <string> reader-status: "Lukijaa ei ole käynnistetty.";
    in-out property <string> reader-port;
    in-out property <string> read-notice;
    in-out property <bool> read-notice-visible;
    in-out property <string> calculation-notes;
    in-out property <string> app-version;
    in-out property <string> default-root;
    in-out property <string> update-status: "Päivityksiä ei ole tarkistettu.";
    in-out property <string> available-version;
    in-out property <bool> update-busy;
    in-out property <bool> install-busy;
    in-out property <bool> managed;
    in-out property <bool> installable;
    in-out property <bool> setup-open;
    in-out property <bool> new-location-visible;
    callback change-default-root();
    callback reset-default-root();
    callback check-updates();
    callback apply-update();
    callback install-app();
    function begin-new() {
        root.new-path = "";
        root.new-name = "";
        root.new-location-visible = false;
        root.dialog-open = true;
    }
    in-out property <bool> dialog-open;
    in-out property <bool> about-open;
    in-out property <string> new-name;
    in-out property <string> new-path;
    in-out property <string> path-input;
    callback navigate(int);
    callback open-file();
    callback open-path(string);
    callback create-project(string, string);
    callback browse-new-path();
    callback open-demo();
    callback reload();
    callback filter-changed(string);
    callback select-row(int);
    callback select-detail(int);
    callback add-record();
    callback add-station();
    callback move-station(int);
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    callback add-commit();
    callback cancel-edit();
    callback export-report();
    callback export-csv();
    callback export-xlsx();
    callback reader-start(string);
    callback reader-stop();
    callback retry-readouts();
    callback import-frame();

    // Pikanäppäimet toimivat myös kentän tai taulukon ollessa kohdistettuna.
    keyboard := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;
    capture-key-pressed(event) => {
        if root.install-busy { return accept; }
        if event.text == Key.Escape {
            if root.about-open {
                root.about-open = false;
                return accept;
            } else if root.dialog-open {
                root.dialog-open = false;
                return accept;
            } else if root.new-record || root.form-blocked {
                root.cancel-edit();
                return accept;
            }
        }
        if event.modifiers.control && !root.reader-running && !root.form-blocked && !root.new-record && !root.dialog-open && !root.about-open {
            if event.text == "o" || event.text == "O" {
                root.open-file();
                return accept;
            } else if event.text == "n" || event.text == "N" {
                root.begin-new();
                return accept;
            }
        }
        reject
    }
    // Yksi navigaatiorakenne ja samat komponentit jokaiselle näkymälle.
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 194px; background: Theme.sidebar;
            VerticalLayout {
                padding: 14px; spacing: 5px;
                Rectangle {
                    height: 76px;
                    VerticalLayout {
                        padding-left: 12px; padding-top: 10px; spacing: 4px;
                        Text { text: "AS2026"; color: white; font-size: 25px; font-weight: 800; letter-spacing: 1px; }
                        Text { text: "KILPAILUNHALLINTA"; color: #8ba4b4; font-size: 9px; letter-spacing: 1.2px; }
                    }
                }
                // Pelkkä vieritettävä navigaatio, ilman ScrollView'n reunaviivaa.
                Flickable {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        width: parent.width;
                        height: 324px;
                        spacing: 5px;
                        for label[index] in ["Yleiskatsaus", "Kilpailijat", "Emit-lukeminen", "Tulokset", "Luokat", "Radat ja asemat", "Asetukset"]: NavItem {
                            label: label;
                            active: root.page == index;
                            chosen => { root.navigate(index); }
                        }
                    }
                }
                // Tyhjä venyvä tila kiinnittää sovellustoiminnot sivupalkin alareunaan.
                Rectangle { vertical-stretch: 1; }
                Text { text: "SOVELLUS"; color: #8ba4b4; font-size: 9px; letter-spacing: 1.2px; height: 22px; vertical-alignment: center; }
                Button {
                    height: Theme.control-height;
                    text: root.update-busy ? "Tarkistetaan…" : root.available-version != "" ? "Asenna " + root.available-version : "Päivitykset ↻";
                    enabled: !root.update-busy && !root.install-busy;
                    clicked => {
                        if root.available-version != "" { root.apply-update(); }
                        else { root.check-updates(); }
                    }
                }
                if root.available-version != "": Note {
                    text: "Asennus käynnistää sovelluksen uudelleen.";
                    font-size: 11px;
                }
                Button { height: Theme.control-height; text: "Tietoja"; clicked => { root.about-open = true; } }
                Rectangle {
                    height: 56px; background: #1b3343; border-radius: 5px;
                    VerticalLayout {
                        padding: 8px; spacing: 4px;
                        Text { text: root.reader-running ? "●  Emit-lukija käynnissä" : "○  Emit-lukija pysäytetty"; color: root.reader-running ? #80d6bb : #a8bdc9; font-size: 11px; }
                        Text { text: "AS2026 " + root.app-version; color: #8ba4b4; font-size: 11px; }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            Rectangle {
                height: 70px; background: Theme.surface;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 18px; padding-bottom: 18px; spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        Text { text: root.competition-name; color: Theme.ink; font-size: 17px; font-weight: 700; overflow: elide; }
                        Text { text: !root.opened ? "Valitse kilpailu aloittaaksesi" : root.editable ? "Automaattinen tallennus" : "AS2015A-aineisto · vain katselu"; color: Theme.muted; font-size: 11px; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { height: Theme.control-height; text: "Avaa"; enabled: !root.reader-running && !root.form-blocked && !root.new-record; clicked => { root.open-file(); } }
                    Button { height: Theme.control-height; text: "+ Uusi"; enabled: !root.reader-running && !root.form-blocked && !root.new-record; primary: true; clicked => { root.begin-new(); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px; spacing: 16px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Heading { text: ["Kilpailun yleiskatsaus", "Kilpailijat", "Emit-lukeminen", "Tulokset", "Luokat", "Radat ja asemat", "Asetukset"][root.page]; }
                        Note { text: ["Kilpailun tiedot ja tärkeimmät työvaiheet yhdessä paikassa.", "Ilmoittautumiset, lähtöajat ja korttien kohdistus.", "Aseta kortti lukijaan. Tiedot kohdistuvat ja tallentuvat automaattisesti.", "Ajantasaiset tulokset ja kilpailijan asemakohtainen tarkastelu.", "Luokkien ratavalinnat ja lähtötiedot.", "Valitse rata ja tarkastele sen asemia järjestyksessä.", "Tallennuspaikka ja avoimen kilpailun asetukset."][root.page]; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.opened && root.page < 5: Button { height: Theme.control-height; text: "Päivitä tiedot"; enabled: !root.reader-running && !root.new-record && !root.form-blocked; clicked => { root.reload(); } }
                }
                if root.page == 0: ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 18px;
                    if !root.opened: Rectangle {
                        height: 335px; vertical-stretch: 0;
                        horizontal-stretch: 1;
                        background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        VerticalLayout {
                            padding: 32px; spacing: 16px;
                            Text { text: "Valmis kilpailupäivään"; font-size: 26px; font-weight: 700; color: Theme.ink; }
                            Note { text: "Avaa olemassa oleva kilpailu tai perusta uusi. Voit myös tutustua ohjelmaan turvallisella esimerkkikilpailulla."; max-width: 580px; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { height: Theme.control-height; text: "Avaa kilpailutiedosto…"; primary: true; clicked => { root.open-file(); } }
                                Button { height: Theme.control-height; text: "Kokeile esimerkillä"; clicked => { root.open-demo(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Rectangle { height: 12px; }
                            Text { text: "Kilpailutiedoston tai vanhan kilpailukansion polku"; color: Theme.ink; font-size: 12px; font-weight: 600; }
                            HorizontalLayout {
                                LineEdit { text <=> root.path-input; placeholder-text: "Liitä tiedoston tai kansion polku"; accepted => { root.open-path(self.text); } }
                                Button { height: Theme.control-height; text: "Avaa polku"; clicked => { root.open-path(root.path-input); } }
                            }
                        }
                    }
                    if root.opened: Rectangle {
                        horizontal-stretch: 1;
                        height: 112px; background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        HorizontalLayout {
                            padding: 20px; spacing: 30px;
                            Metric { label: "Kilpailijaa"; count: root.driver-count; }
                            Metric { label: "Luokkaa"; count: root.class-count; }
                            Metric { label: "Rataa"; count: root.track-count; }
                            Metric { label: "Tallennettua lukemaa"; count: root.read-count; }
                        }
                    }
                    if root.opened: Rectangle {
                        horizontal-stretch: 1;
                        height: 240px;
                        background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                        VerticalLayout {
                            padding: 22px; spacing: 14px;
                            Text { text: "Kilpailun työvaiheet"; font-size: 17px; font-weight: 700; color: Theme.ink; }
                            Note { text: "Tarkista luokat ja radat, lisää kilpailijat ja käynnistä kortinluku. Tuloslaskenta käyttää samoja tietoja kaikkialla."; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { height: Theme.control-height; text: "Kilpailijat →"; clicked => { root.navigate(1); } }
                                Button { height: Theme.control-height; text: "Radat ja asemat →"; clicked => { root.navigate(5); } }
                                Button { height: Theme.control-height; text: "Emit-lukeminen →"; primary: true; enabled: root.editable; clicked => { root.navigate(2); } }
                                Button { height: Theme.control-height; text: "Tulokset →"; clicked => { root.navigate(3); } }
                            }
                            Rectangle { height: 8px; }
                            Note { text: "Kilpailun sijainti"; }
                            Text { text: root.competition-path; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.page > 0 && root.page < 6 && !root.opened: Rectangle {
                    Text { text: "Avaa kilpailu aloittaaksesi."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.opened && root.page == 2: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 14px;
                    Rectangle {
                        height: 105px; background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: Theme.radius;
                        HorizontalLayout {
                            padding: 18px; spacing: 12px;
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: root.reader-running ? "●  Lukija odottaa korttia" : "Kortinluku"; color: Theme.accent; font-size: 17px; font-weight: 700; }
                                Note { text: root.reader-status; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: "Sarjaportti"; color: Theme.muted; font-size: 11px; }
                                LineEdit { width: 200px; text <=> root.reader-port; placeholder-text: "Automaattinen / COM3"; enabled: !root.reader-running; }
                            }
                            Button { height: Theme.control-height; text: root.reader-running ? "Pysäytä luku" : "Käynnistä lukija"; primary: true; enabled: root.editable; clicked => { if root.reader-running { root.reader-stop(); } else { root.reader-start(root.reader-port); } } }
                        }
                    }
                    if root.unsaved-count > 0: HorizontalLayout {
                        Text { text: root.unsaved-count + " lukemaa odottaa tallennusta"; color: Theme.danger; vertical-alignment: center; }
                        Button { height: Theme.control-height; text: "Päivitä ja yritä tallentaa"; enabled: !root.reader-running; clicked => { root.retry-readouts(); } }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Lukuhistoria"; color: Theme.ink; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Text { text: root.read-notice-visible ? root.read-notice : ""; color: Theme.accent; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { height: Theme.control-height; text: "Lue kehystiedosto…"; enabled: root.editable && !root.reader-running; clicked => { root.import-frame(); } }
                    }
                    DataTable { rows: root.rows; headers: root.headers; weights: root.weights; selected-key: root.selected-key; empty-text: "Tallennetut korttiluvut tulevat tähän."; selected(key) => { root.select-row(key); } }
                    if root.detail-rows.length > 0: VerticalLayout {
                        height: 218px; spacing: 8px;
                        Text { text: root.detail-title; color: Theme.ink; font-size: 13px; font-weight: 600; }
                        DataTable {
                            rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights;
                            empty-text: "Valitse lukutapahtuma.";
                        }
                    }
                }
                if root.opened && (root.page == 1 || root.page == 3 || root.page == 4): VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        search := LineEdit { horizontal-stretch: 1; text <=> root.filter; placeholder-text: root.page == 1 ? "Hae nimellä, numerolla tai Emit-numerolla…" : "Hae luettelosta…"; edited => { root.filter-changed(self.text); } }
                        if root.page != 3: Button { height: Theme.control-height; text: root.page == 1 ? "+ Lisää kilpailija" : root.page == 4 ? "+ Lisää luokka" : "+ Lisää rata"; primary: true; enabled: root.editable && !root.new-record; clicked => { root.add-record(); } }
                        if root.page == 3: Button { height: Theme.control-height; text: "Vie XLSX…"; clicked => { root.export-xlsx(); } }
                        if root.page == 3: Button { height: Theme.control-height; text: "Vie CSV…"; clicked => { root.export-csv(); } }
                        if root.page == 3: Button { height: Theme.control-height; text: "Vie HTML-raportti…"; clicked => { root.export-report(); } }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 16px;
                            DataTable { horizontal-stretch: 1; vertical-stretch: 2; rows: root.rows; headers: root.headers; weights: root.weights; selected-key: root.selected-key; empty-text: root.filter != "" ? "Haulla ei löytynyt tietoja." : root.page == 3 ? "Ei vielä tuloksia. Lisää kilpailijat ja lue Emit-kortit." : "Luettelo on tyhjä. Lisää ensimmäinen tietue."; selected(key) => { root.select-row(key); } }
                            if root.page == 3 && root.detail-rows.length > 0: VerticalLayout {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                spacing: 12px;
                                HorizontalLayout {
                                    Text { text: root.detail-title; color: Theme.ink; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                DataTable { horizontal-stretch: 1; vertical-stretch: 1; rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights; selected-key: root.detail-key; empty-text: "Valitse ensin rivi yllä olevasta luettelosta."; selected(key) => { root.select-detail(key); } }
                            }
                        }
                        if root.editor-visible: Editor {
                            width: 310px;
                            heading: root.editor-title; description: root.editor-description;
                            fields: root.fields; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                        }
                    }
                    if root.page == 3: Note { text: root.calculation-notes; }
                }
                // Radat ja asemat: sisällön korkeus määräytyy sen osista,
                // eikä kaksi lähes tyhjää taulukkoa veny koko ikkunan mittaisiksi.
                // Yhden sarakkeen rakenne säilyy käytettävänä myös Nirin pienissä laatoissa.
                if root.opened && root.page == 5: ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 12px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.filter;
                                placeholder-text: "Hae radoista…";
                                edited => { root.filter-changed(self.text); }
                            }
                            Button {
                                height: Theme.control-height;
                                text: "+ Lisää rata";
                                primary: true;
                                enabled: root.editable && !root.new-record;
                                clicked => { root.add-record(); }
                            }
                        }
                        Text { text: "Radat"; color: Theme.ink; font-size: 16px; font-weight: 700; }
                        DataTable {
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            height: 216px;
                            rows: root.rows; headers: root.headers; weights: root.weights;
                            selected-key: root.selected-key;
                            empty-text: root.filter != "" ? "Haulla ei löytynyt ratoja." : "Ei vielä ratoja. Lisää ensimmäinen rata.";
                            selected(key) => { root.select-row(key); }
                        }
                        if root.editor-visible && root.editor-title != "Aseman tiedot" && root.editor-title != "Uusi asema": Editor {
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            height: root.fields.length > 3 ? 384px : root.fields.length > 1 ? 270px : 222px;
                            heading: root.editor-title; description: root.editor-description;
                            fields: root.fields; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.detail-title != "" ? root.detail-title : "Asemat";
                                color: Theme.ink; font-size: 16px; font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Button {
                                height: Theme.control-height; text: "+ Asema";
                                enabled: root.editable && root.selected-key >= 0 && !root.new-record;
                                clicked => { root.add-station(); }
                            }
                            Button {
                                height: Theme.control-height; text: "↑";
                                enabled: root.editable && root.detail-key > 0 && !root.new-record;
                                clicked => { root.move-station(-1); }
                            }
                            Button {
                                height: Theme.control-height; text: "↓";
                                enabled: root.editable && root.detail-key >= 0 && !root.new-record;
                                clicked => { root.move-station(1); }
                            }
                        }
                        DataTable {
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            height: 238px;
                            rows: root.detail-rows; headers: root.detail-headers; weights: root.detail-weights;
                            selected-key: root.detail-key;
                            empty-text: "Valitse rata yllä olevasta luettelosta.";
                            selected(key) => { root.select-detail(key); }
                        }
                        if root.editor-visible && (root.editor-title == "Aseman tiedot" || root.editor-title == "Uusi asema"): Editor {
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            height: root.fields.length > 3 ? 384px : root.fields.length > 1 ? 270px : 222px;
                            heading: root.editor-title; description: root.editor-description;
                            fields: root.fields; writable: root.editable; new-record: root.new-record; blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            add => { root.add-commit(); } cancel => { root.cancel-edit(); }
                        }
                    }
                }
                if root.page == 6: ScrollView {
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 24px;
                        if root.opened: Editor {
                            width: 420px;
                            heading: "Kilpailun asetukset"; description: "Muutokset tallentuvat kentän hyväksymisen jälkeen.";
                            fields: root.fields; writable: root.editable && !root.install-busy; blocked: root.form-blocked;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                            cancel => { root.cancel-edit(); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 18px;
                            Rectangle {
                                horizontal-stretch: 1;
                                min-height: 190px; background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                                VerticalLayout {
                                    padding: 20px; spacing: 12px;
                                    Text { text: "Kilpailujen tallennuspaikka"; color: Theme.ink; font-size: 17px; font-weight: 700; }
                                    Note { text: "Uusi kilpailu tallennetaan omaan kansioonsa tämän sijainnin alle."; }
                                    Text { text: root.default-root; color: Theme.ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Button { height: Theme.control-height; text: "Vaihda sijaintia…"; clicked => { root.change-default-root(); } }
                                        Button { height: Theme.control-height; text: "Palauta oletus"; clicked => { root.reset-default-root(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Note { text: "Sijainnin vaihtaminen koskee uusia kilpailuja. Aiemmat kilpailut säilyvät paikoillaan."; }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
            Rectangle {
                height: root.status-error ? 62px : 38px;
                background: root.status-error ? Theme.danger-soft : Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 12px;
                    Text { text: root.status-error ? "!" : root.editable && root.opened ? "✓" : "i"; color: root.status-error ? Theme.danger : Theme.accent; font-weight: 700; width: 14px; vertical-alignment: center; }
                    Text { text: root.status-text; color: root.status-error ? Theme.danger : Theme.muted; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }
    if root.dialog-open: Rectangle {
        background: #13273580;
        TouchArea { }
        FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { dialog-name.focus(); }
        // Pidä tabulaattorikierto avoimessa valintaikkunassa.
        capture-key-pressed(event) => {
            if event.text == Key.Tab {
                if event.modifiers.shift {
                    if dialog-name.has-focus { dialog-create.focus(); }
                    else if dialog-path.has-focus { dialog-name.focus(); }
                    else if dialog-browse.has-focus { dialog-path.focus(); }
                    else if dialog-location.has-focus { if root.new-location-visible { dialog-browse.focus(); } else { dialog-name.focus(); } }
                    else if dialog-cancel.has-focus { dialog-location.focus(); }
                    else { dialog-cancel.focus(); }
                } else {
                    if dialog-name.has-focus { if root.new-location-visible { dialog-path.focus(); } else { dialog-location.focus(); } }
                    else if dialog-path.has-focus { dialog-browse.focus(); }
                    else if dialog-browse.has-focus { dialog-location.focus(); }
                    else if dialog-location.has-focus { dialog-cancel.focus(); }
                    else if dialog-cancel.has-focus { dialog-create.focus(); }
                    else { dialog-name.focus(); }
                }
                return accept;
            }
            reject
        }
        Rectangle {
            width: min(540px, root.width - 24px); height: min(root.height - 24px, root.new-location-visible ? 370px : 300px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 8px; background: Theme.surface; border-color: Theme.line; border-width: 1px;
            VerticalLayout {
                padding: 26px; spacing: 16px;
                Heading { text: "Uusi kilpailu"; }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Kilpailun nimi"; color: Theme.ink; font-size: 12px; font-weight: 600; }
                    dialog-name := LineEdit {
                        text <=> root.new-name; placeholder-text: "Esimerkiksi Syysajo 2026";
                        accessible-label: "Kilpailun nimi";
                        accepted => { root.create-project(root.new-path, root.new-name); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    visible: root.new-location-visible;
                    height: root.new-location-visible ? 65px : 0px;
                    Text { text: "Tallennuspaikka"; color: Theme.ink; font-size: 12px; font-weight: 600; }
                    HorizontalLayout {
                        dialog-path := LineEdit {
                            text <=> root.new-path; placeholder-text: "Valitse kansio tai anna uuden kansion polku";
                            accessible-label: "Kilpailun kansio";
                            accepted => { root.create-project(root.new-path, root.new-name); }
                        }
                        dialog-browse := Button { height: Theme.control-height; text: "Selaa…"; clicked => { root.browse-new-path(); } }
                    }
                }
                Note { text: "Sijainti: " + (root.new-path == "" ? root.default-root : root.new-path); }
                dialog-location := Button { height: Theme.control-height; text: "Vaihda sijaintia"; clicked => { root.new-location-visible = true; root.browse-new-path(); } }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    dialog-cancel := Button { height: Theme.control-height; text: "Peruuta"; clicked => { root.dialog-open = false; } }
                    dialog-create := Button { height: Theme.control-height; text: "Luo kilpailu"; primary: true; clicked => { root.create-project(root.new-path, root.new-name); } }
                }
            }
        }
        }
    }
    if root.about-open: Rectangle {
        background: #13273580;
        TouchArea { }
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { about-close.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Tab { about-close.focus(); return accept; }
                reject
            }
            Rectangle {
                width: min(480px, root.width - 24px); height: min(460px, root.height - 24px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
                VerticalLayout {
                    padding: 26px; spacing: 14px;
                    Heading { text: "Tietoja AS2026:sta"; }
                    Note { text: "Versio " + root.app-version + " · autosuunnistuksen kilpailunhallinta"; }
                    Text { text: "AS2026:n oma koodi: BSD-2-Clause-lisenssi"; color: Theme.ink; font-size: 14px; }
                    Note { text: "Käyttö, muokkaus ja jakelu on sallittu lisenssin ehdoin. Tekijänoikeusilmoitus ja lisenssiehdot säilytetään jaettaessa. Ei takuuta."; }
                    AboutSlint { horizontal-stretch: 1; vertical-stretch: 1; }
                    about-close := Button { height: Theme.control-height; text: "Sulje"; clicked => { root.about-open = false; } }
                }
            }
        }
    }
    if root.setup-open || root.install-busy: Rectangle {
        background: #132735b0;
        TouchArea { }
        FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { setup-install.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Tab { setup-install.focus(); return accept; }
            reject
        }
        Rectangle {
            width: min(480px, root.width - 24px); height: min(250px, root.height - 24px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
            VerticalLayout {
                padding: 26px; spacing: 16px;
                Heading { text: root.install-busy ? "Asennetaan AS2026:ta" : "Asenna AS2026"; }
                Note { text: root.install-busy ? "Ohjelma avautuu automaattisesti asennuksen valmistuttua." : "Asennus lisää AS2026:n sovellusvalikkoon ja mahdollistaa päivitykset sivupalkista."; }
                Note { text: "Kilpailut ja asetukset säilyvät erillään ohjelmatiedostoista."; }
                HorizontalLayout {
                    if !root.install-busy: Button { height: Theme.control-height; text: "Myöhemmin"; clicked => { root.setup-open = false; } }
                    setup-install := Button { height: Theme.control-height; text: root.install-busy ? "Odota…" : "Asenna ja käynnistä"; primary: true; enabled: !root.install-busy; clicked => { root.install-app(); } }
                }
            }
        }
        }
    }
    }
}
