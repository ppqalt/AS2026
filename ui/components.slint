import { Button, LineEdit, ScrollView, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow, EditorField } from "types.slint";

export component Heading inherits Text {
    color: Theme.ink;
    font-size: Theme.heading-font-size;
    font-weight: 700;
}

export component Note inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();
    height: 42px;
    border-radius: 5px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: #b2ebe0;
    forward-focus: focus;
    background: root.active ? Theme.accent-fill : touch.has-hover ? Theme.sidebar-hover : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 10px;
        Text {
            width: 10px;
            text: "●";
            color: root.active ? #b8f4e9 : #7295a4;
            font-size: 9px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: white;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.chosen(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.chosen();
                return accept;
            }
            reject
        }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
}

// Vain luonnos elää tässä komponentissa; hyväksytty arvo tulee kilpailumallista.
export component FormField inherits VerticalLayout {
    height: 64px; vertical-stretch: 0;
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <bool> writable: true;
    in property <[string]> options;
    in property <[string]> values;
    in property <int> choice;
    in property <bool> duration: false;
    in property <string> hours;
    in property <string> minutes;
    in property <string> seconds;
    callback commit(string) -> bool;
    callback draft(string);
    property <bool> dirty: false;
    property <bool> invalid: false;
    function duration-value() -> string {
        return hour-input.text + ":" + minute-input.text + ":" + second-input.text;
    }
    function duration-edited() {
        root.dirty = true;
        root.invalid = false;
        root.draft(root.duration-value());
    }
    function duration-accepted() {
        if root.dirty {
            root.invalid = !root.commit(root.duration-value());
            root.dirty = root.invalid;
        }
    }
    spacing: 5px;
    Text { height: 16px; text: root.label; color: Theme.ink; font-size: 12px; font-weight: 600; }
    Rectangle {
        height: 40px;
        border-width: root.invalid ? 1px : 0px;
        border-color: Theme.danger;
        border-radius: 5px;
        duration-input := HorizontalLayout {
            visible: root.duration;
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            spacing: 4px;
            hour-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.hours; placeholder-text: "hh";
                enabled: root.writable; accessible-label: "Tavoiteaika, tunnit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
            Text { text: ":"; color: Theme.muted; font-size: 17px; vertical-alignment: center; }
            minute-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.minutes; placeholder-text: "mm";
                enabled: root.writable; accessible-label: "Tavoiteaika, minuutit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
            Text { text: ":"; color: Theme.muted; font-size: 17px; vertical-alignment: center; }
            second-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.seconds; placeholder-text: "ss";
                enabled: root.writable; accessible-label: "Tavoiteaika, sekunnit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
        }
        choice := ComboBox {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            visible: !root.duration && root.options.length > 0;
            model: root.options; current-index: root.choice;
            enabled: root.writable && !root.duration && root.options.length > 0;
            accessible-label: root.label;
            selected => {
                root.draft(root.values[self.current-index]);
                root.invalid = !root.commit(root.values[self.current-index]);
                root.dirty = root.invalid;
            }
        }
        input := LineEdit {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            visible: !root.duration && root.options.length == 0;
            text: root.value;
            placeholder-text: root.hint;
            enabled: root.writable && !root.duration && root.options.length == 0;
            accessible-label: root.label;
            edited => {
                root.dirty = true; root.invalid = false;
                root.draft(self.text);
            }
            accepted => {
                if root.dirty {
                    root.invalid = !root.commit(self.text);
                    root.dirty = root.invalid;
                }
            }
            changed has-focus => {
                if !self.has-focus && root.dirty {
                    root.invalid = !root.commit(self.text);
                    root.dirty = root.invalid;
                }
            }
        }
    }
}

export component DataTable inherits Rectangle {
    in property <[TableRow]> rows;
    in property <[string]> headers;
    in property <[float]> weights;
    in property <int> selected-key: -1;
    in property <string> empty-text: "Ei tietoja.";
    callback selected(int);
    in property <length> table-min-height: 160px;
    min-width: 260px;
    min-height: root.table-min-height;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: Theme.radius;
    clip: true;
    VerticalLayout {
        padding: 1px; spacing: 0px;
        Rectangle {
            height: 36px; background: #23313b;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; spacing: 10px;
                for title[i] in root.headers: Text {
                    text: title; horizontal-stretch: root.weights[i];
                    min-width: 0px; preferred-width: 0px;
                    font-size: 11px; font-weight: 700; color: Theme.muted;
                    vertical-alignment: center; overflow: elide;
                }
            }
        }
        body := Rectangle {
            vertical-stretch: 1;
            list := ListView {
            for row[index] in root.rows: Rectangle {
                property <bool> active: row.key == root.selected-key;
                height: Theme.row-height;
                background: row.key == root.selected-key ? Theme.accent-soft : touch.has-hover ? #1c2b35 : Theme.surface;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    for value[i] in row.cells: Text {
                        text: value; horizontal-stretch: root.weights[i];
                        min-width: 0px; preferred-width: 0px;
                        color: i == 0 ? Theme.accent : Theme.ink;
                        font-weight: i == 0 ? 600 : 400;
                        font-size: 13px; vertical-alignment: center; overflow: elide;
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: #23313b; }
                touch := TouchArea { clicked => { root.selected(row.key); } }
                accessible-role: list-item;
                accessible-label: row.cells[0] + " " + row.cells[1];
                accessible-action-default => { root.selected(row.key); }
            }
            }
            if root.rows.length == 0: Text {
                text: root.empty-text; color: Theme.muted; font-size: 14px;
                x: 20px; y: 0px; width: parent.width - 40px; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            }
        }
    }
}

// Use one station field model for both the wide grid and the narrow editor.
component EditorEntry inherits FormField {
    in property <EditorField> data;
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    label: root.data.label;
    value: root.data.value;
    hint: root.data.hint;
    options: root.data.options;
    values: root.data.values;
    choice: root.data.choice;
    duration: root.data.duration;
    hours: root.data.hours;
    minutes: root.data.minutes;
    seconds: root.data.seconds;
    commit(value) => { root.field-commit(root.data.key, value) }
    draft(value) => { root.field-draft(root.data.key, value); }
}

export component Editor inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <[EditorField]> fields;
    in property <bool> writable;
    in property <bool> new-record;
    in property <bool> blocked;
    in property <bool> station-layout: false;
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    callback add();
    callback cancel();
    background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
    VerticalLayout {
        padding: 18px; spacing: 12px;
        Text { text: root.heading; color: Theme.ink; font-size: 17px; font-weight: 700; wrap: word-wrap; }
        Note { text: root.description; }
        ScrollView {
            VerticalLayout {
                spacing: 12px; padding-right: 8px;
                if root.station-layout && root.fields.length == 6 && root.width >= 540px: GridLayout {
                    spacing: 12px;
                    vertical-stretch: 0;
                    Row {
                        EditorEntry { data: root.fields[0]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                        EditorEntry { data: root.fields[1]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                    }
                    Row {
                        EditorEntry { data: root.fields[2]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                        EditorEntry { data: root.fields[3]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                    }
                    Row {
                        EditorEntry { data: root.fields[4]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                        EditorEntry { data: root.fields[5]; writable: root.writable;
                            field-commit(key, value) => { root.field-commit(key, value) }
                            field-draft(key, value) => { root.field-draft(key, value); }
                        }
                    }
                }
                if !root.station-layout || root.fields.length != 6 || root.width < 540px: VerticalLayout {
                    spacing: 12px;
                    for field in root.fields: EditorEntry {
                        data: field; writable: root.writable;
                        field-commit(key, value) => { root.field-commit(key, value) }
                        field-draft(key, value) => { root.field-draft(key, value); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.new-record: HorizontalLayout {
            Button { height: Theme.control-height; text: "Peruuta"; clicked => { root.cancel(); } }
            Button { height: Theme.control-height; text: "Lisää"; primary: true; enabled: root.writable; clicked => { root.add(); } }
        }
        if root.blocked && !root.new-record: Button { height: Theme.control-height;
            text: "Palauta tallennetut tiedot";
            clicked => { root.cancel(); }
        }
    }
}

export component Metric inherits VerticalLayout {
    in property <string> label;
    in property <int> count;
    spacing: 6px;
    Text { text: root.count; color: Theme.ink; font-size: 28px; font-weight: 700; }
    Note { text: root.label; }
}
