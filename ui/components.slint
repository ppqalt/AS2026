import { ListView } from "std-widgets.slint";
import { UiButton as Button, UiTextField as LineEdit, UiScrollView as ScrollView, UiComboBox as ComboBox, UiCheckBox as CheckBox } from "presets.slint";
import { Theme } from "theme.slint";
import { TableRow, EditorField } from "types.slint";

export component Heading inherits Text {
    color: Theme.ink;
    font-size: Theme.heading-font-size;
    font-weight: Theme.strong-font-weight;
}

export component Note inherits Text {
    color: Theme.muted;
    font-size: Theme.body-font-size;
    wrap: word-wrap;
}

// Sama Fluent-painike, kohdistus ja esteettömyys kaikille toiminnoille.
export component AccentButton inherits Button {
    primary: true;
}

// Sama tilanjako luetteloille ja muokkaimille. Kapeassa tai lyhyessä ikkunassa
// kumpikin saa koko työalueen; paneeleja ei puristeta rinnakkain.
export component Workspace inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    in property <bool> has-details;
    in property <string> list-label: "Luettelo";
    in property <string> details-label: "Tiedot";
    in property <length> preferred-details-width: Theme.editor-width;
    in property <length> maximum-details-width: Theme.editor-max-width;
    in-out property <bool> show-details;
    out property <bool> compact: root.width < Theme.workspace-min-main-width + root.preferred-details-width + Theme.space-4 || root.height < Theme.workspace-min-split-height;
    property <length> tabs-height: root.compact && root.has-details ? Theme.control-height + Theme.space-3 : 0px;
    out property <length> content-y: root.tabs-height;
    out property <length> content-height: max(0px, root.height - root.tabs-height);
    out property <length> details-width: root.compact ? root.width : min(root.maximum-details-width, max(root.preferred-details-width, root.width * 0.28));
    out property <length> list-width: !root.has-details || root.compact ? root.width : root.width - root.details-width - Theme.space-4;
    out property <length> details-x: root.compact ? 0px : root.list-width + Theme.space-4;
    out property <bool> list-visible: !root.compact || !root.has-details || !root.show-details;
    out property <bool> details-visible: root.has-details && (!root.compact || root.show-details);
    if root.compact && root.has-details: HorizontalLayout {
        x: 0px; y: 0px; width: root.width;
        height: Theme.control-height;
        spacing: Theme.space-2;
        alignment: start;
        Button { text: root.list-label; checkable: true; checked: !root.show-details; clicked => { root.show-details = false; } }
        Button { text: root.details-label; checkable: true; checked: root.show-details; clicked => { root.show-details = true; } }
    }
    @children
}

// Sisällöstä erillinen pinta: kutsuja järjestää vieritettävän sisällön ja alatunnisteen.
export component DialogSurface inherits Rectangle {
    in property <length> preferred-dialog-width: Theme.dialog-width;
    in property <length> preferred-dialog-height: 520px;
    in property <length> available-width;
    in property <length> available-height;
    width: min(root.preferred-dialog-width, max(0px, root.available-width - 2 * Theme.dialog-margin));
    height: min(root.preferred-dialog-height, max(0px, root.available-height - 2 * Theme.dialog-margin));
    x: (root.available-width - self.width) / 2;
    y: (root.available-height - self.height) / 2;
    border-radius: Theme.radius-large;
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
}

export component DialogActions inherits HorizontalLayout {
    spacing: Theme.space-2;
    alignment: end;
    vertical-stretch: 0;
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();
    height: 40px;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.sidebar-hover : transparent;
    animate background { enabled: Theme.effects-enabled; duration: 120ms; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    forward-focus: focus;
    // Keskitys sidotaan rivin todelliseen korkeuteen, myös skaalattaessa.
    selection-rail := Rectangle {
        width: 3px;
        height: max(0px, root.height - Theme.space-3);
        y: (root.height - self.height) / 2;
        x: 0px;
        border-radius: self.width / 2;
        background: root.active ? Theme.accent-fill : transparent;
    }
    Text {
        x: 14px;
        width: root.width - 22px;
        height: root.height;
        text: root.label;
        color: root.active ? Theme.accent-text : Theme.muted;
        font-size: Theme.body-font-size;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.chosen(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.chosen();
                return accept;
            }
            reject
        }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
}

// Vain luonnos elää tässä komponentissa; hyväksytty arvo tulee kilpailumallista.
export component FormField inherits VerticalLayout {
    min-height: max(Theme.field-height, field-label.preferred-height + Theme.control-height + 2 * Theme.space-1) + (root.invalid ? field-error.preferred-height + Theme.space-1 : 0px);
    max-height: self.min-height;
    vertical-stretch: 0;
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <string> error;
    in property <bool> writable: true;
    in property <[string]> options;
    in property <[string]> values;
    in property <int> choice;
    in property <bool> duration: false;
    in property <string> hours;
    in property <string> minutes;
    in property <string> seconds;
    callback commit(string) -> bool;
    callback draft(string);
    property <bool> dirty: false;
    out property <bool> invalid: false;
    public function focus-first() {
        if root.duration { hour-input.focus(); }
        else if root.options.length > 0 { choice.focus(); }
        else { input.focus(); }
    }
    public function focus-last() {
        if root.duration { second-input.focus(); }
        else { root.focus-first(); }
    }
    public function first-focused() -> bool { accepted-focus.has-focus || (root.duration ? hour-input.has-focus : root.options.length > 0 ? choice.has-focus : input.has-focus) }
    public function last-focused() -> bool { accepted-focus.has-focus || (root.duration ? second-input.has-focus : root.first-focused()) }
    init => { root.invalid = root.error != ""; }
    changed error => { root.invalid = root.error != ""; }
    function duration-value() -> string {
        if hour-input.text == "" && minute-input.text == "" && second-input.text == "" { return ""; }
        return hour-input.text + ":" + minute-input.text + ":" + second-input.text;
    }
    function duration-edited() {
        root.dirty = true;
        root.invalid = false;
        root.draft(root.duration-value());
    }
    function duration-accepted() {
        if root.dirty {
            root.invalid = !root.commit(root.duration-value());
            root.dirty = root.invalid;
        }
    }
    spacing: Theme.space-1;
    padding-bottom: Theme.space-1;
    field-label := Text { height: self.preferred-height; vertical-stretch: 0; text: root.label; color: Theme.muted; font-size: Theme.label-font-size; font-weight: 600; wrap: word-wrap; }
    Rectangle {
        height: Theme.control-height;
        // Enterin jälkeen kohdistus jää lomakkeelle ilman kentän korostusta.
        accepted-focus := FocusScope {
            width: 0px; height: 0px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
        }
        duration-input := HorizontalLayout {
            visible: root.duration;
            width: parent.width; height: parent.height;
            spacing: Theme.space-1;
            hour-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.hours; placeholder-text: "hh";
                enabled: root.writable; accessible-label: root.label + ", tunnit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); if !root.invalid { accepted-focus.focus(); } }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
            Text { text: ":"; color: Theme.muted; font-size: Theme.body-font-size; vertical-alignment: center; }
            minute-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.minutes; placeholder-text: "mm";
                enabled: root.writable; accessible-label: root.label + ", minuutit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); if !root.invalid { accepted-focus.focus(); } }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
            Text { text: ":"; color: Theme.muted; font-size: Theme.body-font-size; vertical-alignment: center; }
            second-input := LineEdit {
                min-width: 40px; horizontal-stretch: 1;
                text: root.seconds; placeholder-text: "ss";
                enabled: root.writable; accessible-label: root.label + ", sekunnit";
                edited => { root.duration-edited(); }
                accepted => { root.duration-accepted(); if !root.invalid { accepted-focus.focus(); } }
                changed has-focus => { if !self.has-focus { root.duration-accepted(); } }
            }
        }
        choice := ComboBox {
            width: parent.width; height: parent.height;
            visible: !root.duration && root.options.length > 0;
            model: root.options; current-index: root.choice;
            enabled: root.writable && !root.duration && root.options.length > 0;
            accessible-label: root.label;
            selected => {
                root.draft(root.values[self.current-index]);
                root.invalid = !root.commit(root.values[self.current-index]);
                root.dirty = root.invalid;
            }
        }
        input := LineEdit {
            width: parent.width; height: parent.height;
            visible: !root.duration && root.options.length == 0;
            text: root.value;
            placeholder-text: root.hint;
            enabled: root.writable && !root.duration && root.options.length == 0;
            accessible-label: root.label;
            edited => {
                root.dirty = true; root.invalid = false;
                root.draft(self.text);
            }
            accepted => {
                if root.dirty {
                    root.invalid = !root.commit(self.text);
                    root.dirty = root.invalid;
                }
                if !root.invalid { accepted-focus.focus(); }
            }
            changed has-focus => {
                if !self.has-focus && root.dirty {
                    root.invalid = !root.commit(self.text);
                    root.dirty = root.invalid;
                }
            }
        }
        Rectangle {
            width: parent.width; height: parent.height;
            border-width: root.invalid ? 1px : 0px;
            border-color: Theme.danger;
            border-radius: Theme.radius;
            background: transparent;
        }
    }
    field-error := Text {
        visible: root.invalid;
        height: root.invalid ? self.preferred-height : 0px;
        vertical-stretch: 0;
        text: root.error != "" ? root.error : "Tarkista kentän arvo.";
        color: Theme.danger;
        font-size: Theme.label-font-size;
        wrap: word-wrap;
    }
}

export component DataTable inherits Rectangle {
    in property <[TableRow]> rows;
    in property <[string]> headers;
    in property <[float]> weights;
    in property <int> selected-key: -1;
    in property <string> empty-text: "Ei tietoja.";
    callback selected(int);
    in property <length> table-min-height: 160px;
    // Sisällön leveys ei kasvata ikkunan vähimmäisleveyttä.
    in property <length> content-min-width: max(520px, root.headers.length * 85px);
    min-width: 260px;
    min-height: root.table-min-height;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: Theme.radius;
    clip: true;
    horizontal := ScrollView {
        x: 1px; y: 1px;
        width: root.width - 2px; height: root.height - 2px;
        horizontal-scrollbar-policy: as-needed;
        vertical-scrollbar-policy: always-off;
        content-width: max(self.visible-width, root.content-min-width);
        content-height: self.visible-height;
        VerticalLayout {
            x: 0px; y: 0px;
            width: horizontal.content-width;
            height: horizontal.visible-height;
            spacing: 0px;
            Rectangle {
                height: Theme.control-height; background: Theme.table-header;
                HorizontalLayout {
                    padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-2;
                    for title[i] in root.headers: Text {
                        text: title; horizontal-stretch: root.weights[i];
                        min-width: 0px; preferred-width: 0px;
                        font-size: Theme.caption-font-size; font-weight: Theme.strong-font-weight; color: Theme.muted;
                        vertical-alignment: center;
                    }
                }
            }
            body := Rectangle {
                vertical-stretch: 1;
                list := ListView {
                    // Pystyvieritys pysyy ikkunan reunassa myös vaakavierityksen aikana.
                    x: -horizontal.content-x;
                    width: horizontal.visible-width;
                    content-width: horizontal.content-width;
                    content-x <=> horizontal.content-x;
                    horizontal-scrollbar-policy: always-off;
                    for row[index] in root.rows: Rectangle {
                        property <bool> active: row.key == root.selected-key;
                        width: horizontal.content-width;
                        height: Theme.row-height;
                        background: row.key == root.selected-key ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : Theme.surface;
                        HorizontalLayout {
                            padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-2;
                            for value[i] in row.cells: Text {
                                text: value; horizontal-stretch: root.weights[i];
                                min-width: 0px; preferred-width: 0px;
                                color: row.key == root.selected-key ? Theme.accent-text : Theme.ink;
                                font-weight: i == 0 ? 600 : 400;
                                font-size: Theme.body-font-size; vertical-alignment: center;
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        touch := TouchArea { clicked => { root.selected(row.key); } }
                        accessible-role: list-item;
                        accessible-label: row.cells[0] + " " + row.cells[1];
                        accessible-action-default => { root.selected(row.key); }
                    }
                }
                if root.rows.length == 0: Text {
                    text: root.empty-text; color: Theme.muted; font-size: Theme.body-font-size;
                    x: 20px - horizontal.content-x; y: 0px;
                    width: horizontal.visible-width - 40px; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                }
            }
        }
    }
}

// Use one station field model for both the wide grid and the narrow editor.
component EditorEntry inherits FormField {
    in property <EditorField> data;
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    label: root.data.label;
    value: root.data.value;
    hint: root.data.hint;
    error: root.data.error;
    options: root.data.options;
    values: root.data.values;
    choice: root.data.choice;
    duration: root.data.duration;
    hours: root.data.hours;
    minutes: root.data.minutes;
    seconds: root.data.seconds;
    commit(value) => { root.field-commit(root.data.key, value) }
    draft(value) => { root.field-draft(root.data.key, value); }
}

// Tulospaneelissa ulompi vieritys omistaa koko lomakkeen korkeuden.
component EditorFields inherits VerticalLayout {
    min-width: 0px;
    alignment: start;
    in property <[EditorField]> fields;
    in property <bool> writable;
    in property <bool> blocked;
    in property <bool> driver-layout;
    in property <bool> station-layout;
    in property <int> columns: 1;
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    height: self.min-height;
    vertical-stretch: 0;
    spacing: Theme.space-3;
    padding-right: Theme.space-2;
    in-out property <bool> details-open: false;
    property <bool> grouped: root.driver-layout && (root.fields.length == 17 || root.fields.length == 18);
    // Pääikkunan vähimmäiskoko jättää asemalomakkeelle kaksi palstaa.
    // Sisällön leveys ei saa määrittää saman asettelun vähimmäisleveyttä.
    property <bool> station-grid: root.station-layout && root.fields.length == 6;
    property <[EditorField]> basic-fields: root.grouped ? [root.fields[0], root.fields[1], root.fields[2], root.fields[3], root.fields[4], root.fields[5], root.fields[6], root.fields[7], root.fields[8], root.fields[9], root.fields[10], root.fields[13], root.fields[14]] : root.fields;
    if root.station-grid: GridLayout {
        spacing: Theme.space-3;
        vertical-stretch: 0;
        Row {
            EditorEntry { data: root.fields[0]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
            EditorEntry { data: root.fields[1]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
        }
        Row {
            EditorEntry { data: root.fields[2]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
            EditorEntry { data: root.fields[3]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
        }
        Row {
            EditorEntry { data: root.fields[4]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
            EditorEntry { data: root.fields[5]; writable: root.writable;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
        }
    }
    if !root.station-grid && root.columns == 1: VerticalLayout {
        spacing: Theme.space-3;
        for field in root.basic-fields: EditorEntry {
            data: field; writable: root.writable;
            field-commit(key, value) => { root.field-commit(key, value) }
            field-draft(key, value) => { root.field-draft(key, value); }
        }
    }
    if root.columns > 1: HorizontalLayout {
        spacing: Theme.space-5;
        for column in root.columns: VerticalLayout {
            alignment: start; spacing: Theme.space-3; horizontal-stretch: 1;
            min-width: 0px; preferred-width: 0px;
            for position in Math.ceil(root.basic-fields.length / root.columns): VerticalLayout {
                property <int> field-index: column * Math.ceil(root.basic-fields.length / root.columns) + position;
                if self.field-index < root.basic-fields.length: EditorEntry {
                    data: root.basic-fields[parent.field-index]; writable: root.writable;
                    field-commit(key, value) => { root.field-commit(key, value) }
                    field-draft(key, value) => { root.field-draft(key, value); }
                }
            }
        }
    }
    if root.grouped && root.fields.length == 18: EditorEntry {
        data: root.fields[17]; writable: root.writable;
        field-commit(key, value) => { root.field-commit(key, value) }
        field-draft(key, value) => { root.field-draft(key, value); }
    }
    if root.grouped: Button { text: root.details-open ? "Piilota seurat ja lisenssit" : "Seurat ja lisenssit"; enabled: !root.blocked; clicked => { root.details-open = !root.details-open; } }
    if root.grouped && root.details-open: VerticalLayout {
        spacing: Theme.space-3;
        for field in [root.fields[15], root.fields[16], root.fields[11], root.fields[12]]: EditorEntry {
            data: field; writable: root.writable;
            field-commit(key, value) => { root.field-commit(key, value) }
            field-draft(key, value) => { root.field-draft(key, value); }
        }
    }
}

export component Editor inherits Rectangle {
    min-width: 0px;
    in property <string> record-key;
    in-out property <length> scroll-offset: 0px;
    changed record-key => { root.scroll-offset = 0px; }
    in property <string> heading;
    in property <string> description;
    in property <string> error;
    in property <[EditorField]> fields;
    in property <bool> writable;
    in property <bool> new-record;
    in property <bool> deletable;
    callback delete();
    in property <bool> blocked;
    in property <bool> station-layout: false;
    in property <bool> driver-layout: false;
    in property <int> columns: 1;
    in-out property <bool> details-open;
    in-out property <length> scroll-min;
    in property <bool> can-edit-emit;
    callback edit-emit();
    // Ulompi ScrollView vastaa koko paneelista: tämän editorin kenttiä ei rajata.
    in property <bool> fit-content: false;
    min-height: root.fit-content ? editor-content.min-height : 0px;
    preferred-height: root.fit-content ? editor-content.min-height : 300px;
    callback field-commit(int, string) -> bool;
    callback field-draft(int, string);
    callback add();
    callback cancel();
    background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: Theme.radius;
    editor-content := VerticalLayout {
        height: root.fit-content ? self.min-height : parent.height;
        padding: Theme.panel-padding; spacing: Theme.space-3;
        if root.can-edit-emit: Button { text: "Emit-leimat / Luo leimarivi"; clicked => { root.edit-emit(); } }
        Text { text: root.heading; vertical-stretch: 0; color: Theme.ink; font-size: Theme.section-font-size; font-weight: Theme.strong-font-weight; wrap: word-wrap; }
        if root.error != "": Text { text: root.error; color: Theme.danger; font-size: Theme.label-font-size; wrap: word-wrap; }
        if root.description != "": Note { text: root.description; }
        if root.fit-content: EditorFields {
            fields: root.fields; writable: root.writable; blocked: root.blocked;
            driver-layout: root.driver-layout;
            columns: root.columns;
            station-layout: root.station-layout;
            details-open <=> root.details-open;
            field-commit(key, value) => { root.field-commit(key, value) }
            field-draft(key, value) => { root.field-draft(key, value); }
        }
        if !root.fit-content: fields-scroll := ScrollView {
            // Read layout after a frame, never during conditional component initialization.
            clamp-scroll := Timer {
                interval: 16ms; running: true;
                triggered => {
                    root.scroll-min = min(0px, fields-scroll.visible-height - fields-scroll.content-height);
                    fields-scroll.content-y = min(0px, max(root.scroll-min, fields-scroll.content-y));
                }
            }
            horizontal-scrollbar-policy: always-off;
            content-y <=> root.scroll-offset;
            content-height: scroll-fields.min-height;
            scroll-fields := EditorFields {
                x: 0px; y: 0px;
                width: fields-scroll.visible-width;
                fields: root.fields; writable: root.writable; blocked: root.blocked;
                driver-layout: root.driver-layout;
                columns: root.columns;
                station-layout: root.station-layout;
                details-open <=> root.details-open;
                field-commit(key, value) => { root.field-commit(key, value) }
                field-draft(key, value) => { root.field-draft(key, value); }
            }
        }
        if root.deletable: Button { text: "Poista luokka"; preset-variant: "danger"; clicked => { root.delete(); } }
        if root.new-record: HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle { horizontal-stretch: 1; }
            Button { height: Theme.control-height; text: "Tyhjennä luonnos"; clicked => { root.cancel(); } }
        }
        if root.blocked && !root.new-record: Button { height: Theme.control-height;
            text: "Palauta tallennetut tiedot";
            clicked => { root.cancel(); }
        }
    }
}

export component Metric inherits VerticalLayout {
    in property <string> label;
    in property <int> count;
    spacing: Theme.space-1;
    Text { text: root.count; color: Theme.ink; font-size: 26px; font-weight: Theme.strong-font-weight; }
    Note { text: root.label; }
}

// Vieritettävän valintalistan rivit saavutetaan myös näkymän ulkopuolelta.
export component ChoiceRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <int> index;
    in property <int> focus-index;
    callback toggle(bool);
    callback move(int);
    callback focused(int);
    height: Theme.control-height; vertical-stretch: 0;
    changed focus-index => { if root.focus-index == root.index { focus-timer.running = true; } }
    focus-timer := Timer { interval: 1ms; triggered => { self.running = false; if root.focus-index == root.index { choice.focus(); } } }
    FocusScope {
        width: parent.width; height: parent.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Tab { root.move(root.index + (event.modifiers.shift ? -1 : 1)); return accept; }
            reject
        }
        choice := CheckBox {
            width: parent.width; height: parent.height;
            text: root.text; checked: root.checked;
            toggled => { root.toggle(self.checked); }
            changed has-focus => { if self.has-focus { root.focused(root.index); } }
        }
    }
}
