import { UiButton as Button, UiCheckBox as CheckBox } from "presets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { ClassSelection } from "class-selection.slint";
import { DrawClassOption } from "types.slint";
export component PrintClassesDialog inherits Rectangle {
    in property <bool> stations;
    in property <[DrawClassOption]> classes;
    in property <string> printer;
    in property <string> error;
    in-out property <bool> landscape;
    in-out property <bool> fit;
    callback toggle(int, bool);
    callback select-all(bool);
    callback close(bool);
    background: Theme.modal-backdrop;
    TouchArea {}
    Timer { interval: 1ms; running: true; triggered => { self.running = false; cancel.focus(); } }
    FocusScope {
        width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            if event.text == Key.Tab {
                if event.modifiers.shift && choices.search-focused {
                    if choices.selected-count > 0 { print.focus(); } else { cancel.focus(); }
                    return accept;
                }
                if !event.modifiers.shift && (print.has-focus || (cancel.has-focus && choices.selected-count == 0)) {
                    choices.focus-search(); return accept;
                }
            }
            reject
        }
        DialogSurface {
            available-width: root.width; available-height: root.height;
            preferred-dialog-width: 760px;
            minimum-dialog-height: 480px; maximum-dialog-height: 1120px;
            content-dialog-height: form-layout.min-height - choices.min-height + max(200px, 124px + ceil(root.classes.length / 2) * 80px + 24px);
            form-layout := VerticalLayout {
                padding: Theme.dialog-padding; spacing: Theme.space-2;
                Heading { text: root.stations ? "Tulosta asematulokset" : "Tulosta luokkatulokset"; }
                Note { text: "Jokainen valittu luokka aloittaa oman sivun."; }
                choices := ClassSelection {
                    vertical-stretch: 1; min-height: 200px;
                    classes: root.classes;
                    toggle(index, selected) => { root.toggle(index, selected); }
                    select-all(selected) => { root.select-all(selected); }
                }
                if root.error != "": Note { text: root.error; color: Theme.danger; }
                CheckBox { text: "Vaakasuuntainen A4"; checked <=> root.landscape; }
                CheckBox { text: "Sovita kukin luokka yhdelle sivulle"; checked <=> root.fit; }
                Note { text: "Tulostin: " + root.printer; }
                DialogActions {
                    cancel := Button { text: "Peruuta"; clicked => { root.close(false); } }
                    print := AccentButton {
                        text: "Tulosta (" + choices.selected-count + ")";
                        enabled: choices.selected-count > 0;
                        clicked => { root.close(true); }
                    }
                }
            }
        }
    }
}
