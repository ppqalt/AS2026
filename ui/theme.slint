// Yhteiset värit ja mitoitukset. Näkymät käyttävät näitä arvoja.
export global Theme {
    out property <ColorScheme> color-scheme: ColorScheme.dark;
    out property <length> control-height: 34px;
    out property <length> body-font-size: 14px;
    out property <length> heading-font-size: 22px;
    out property <color> canvas: #0c1116;
    out property <color> surface: #141c23;
    out property <color> ink: #e7edf2;
    out property <color> muted: #a1b1bd;
    out property <color> line: #2c3b46;
    out property <color> accent: #52cdb5;
    out property <color> accent-fill: #087b72;
    out property <color> accent-soft: #173a35;
    out property <color> sidebar: #0b1720;
    out property <color> sidebar-hover: #1c3342;
    out property <color> danger: #ffb1a6;
    out property <color> danger-soft: #3b2326;
    out property <length> sidebar-width: 196px;
    out property <length> gutter: 24px;
    out property <length> row-height: 42px;
    out property <length> radius: 6px;
}
