export global Theme {
    // Global gate for optional animated transitions, effects, and future blur.
    // Default stays off even when the operating system permits visual effects.
    in-out property <bool> effects-enabled: false;
    // 0 = järjestelmä, 1 = vaalea, 2 = tumma, 3 = Tumma kuusi, 4 = Hiillos, 5 = Shanghai, 6 = Yömeri, 7 = Kanerva, 8 = Ruusu, 9 = Revontuli.
    in-out property <int> appearance-index: 0;
    out property <ColorScheme> color-scheme: Theme.appearance-index == 1 ? ColorScheme.light :
        Theme.appearance-index >= 2 && Theme.appearance-index <= 9 ? ColorScheme.dark :
        ColorSchemeSelector.color-scheme == ColorScheme.dark ? ColorScheme.dark : ColorScheme.light;
    out property <bool> dark: Theme.color-scheme == ColorScheme.dark;
    out property <string> font-family: "Segoe UI Variable";
    out property <length> control-height: 36px;
    out property <length> control-compact: 28px;
    out property <length> control-large: 44px;
    out property <length> icon-size: 20px;
    out property <length> icon-small: 16px;
    out property <duration> duration-fast: 120ms;
    out property <duration> duration-normal: 180ms;
    out property <length> header-height: 64px;
    out property <length> control-min-width: 76px;
    out property <length> body-font-size: 14px;
    out property <length> label-font-size: 12px;
    out property <length> caption-font-size: 12px;
    out property <length> section-font-size: 16px;
    out property <length> heading-font-size: 22px;
    out property <int> strong-font-weight: 600;
    out property <length> field-height: 64px;
    out property <length> panel-padding: 16px;
    out property <length> dialog-padding: 24px;
    out property <length> dialog-margin: 12px;
    out property <length> dialog-width: 560px;
    out property <length> dialog-wide-width: 1100px;
    out property <length> editor-width: 368px;
    out property <length> editor-min-width: 320px;
    out property <length> editor-max-width: 420px;
    out property <length> workspace-min-main-width: 540px;
    out property <length> workspace-min-split-height: 440px;
    out property <length> table-min-height: 180px;
    out property <length> settings-max-width: 1680px;
    out property <length> scrollbar-width: 14px;
    out property <length> sidebar-width: 200px;
    out property <length> gutter: 20px;
    out property <length> row-height: 38px;
    out property <length> radius: 4px;
    out property <length> radius-large: 8px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;

    out property <color> canvas: Theme.appearance-index == 9 ? RevontuliColors.canvas : Theme.appearance-index == 8 ? RuusuColors.canvas : Theme.appearance-index == 7 ? KanervaColors.canvas : Theme.appearance-index == 6 ? YomeriColors.canvas : Theme.appearance-index == 5 ? ShanghaiColors.canvas : Theme.appearance-index == 4 ? HiillosColors.canvas : Theme.appearance-index == 3 ? SpruceColors.canvas : Theme.dark ? DarkColors.canvas : LightColors.canvas;
    out property <color> surface: Theme.appearance-index == 9 ? RevontuliColors.surface : Theme.appearance-index == 8 ? RuusuColors.surface : Theme.appearance-index == 7 ? KanervaColors.surface : Theme.appearance-index == 6 ? YomeriColors.surface : Theme.appearance-index == 5 ? ShanghaiColors.surface : Theme.appearance-index == 4 ? HiillosColors.surface : Theme.appearance-index == 3 ? SpruceColors.surface : Theme.dark ? DarkColors.surface : LightColors.surface;
    out property <color> surface-raised: Theme.appearance-index == 9 ? RevontuliColors.surface-raised : Theme.appearance-index == 8 ? RuusuColors.surface-raised : Theme.appearance-index == 7 ? KanervaColors.surface-raised : Theme.appearance-index == 6 ? YomeriColors.surface-raised : Theme.appearance-index == 5 ? ShanghaiColors.surface-raised : Theme.appearance-index == 4 ? HiillosColors.surface-raised : Theme.appearance-index == 3 ? SpruceColors.surface-raised : Theme.dark ? DarkColors.surface-raised : LightColors.surface-raised;
    out property <color> surface-hover: Theme.appearance-index == 9 ? RevontuliColors.surface-hover : Theme.appearance-index == 8 ? RuusuColors.surface-hover : Theme.appearance-index == 7 ? KanervaColors.surface-hover : Theme.appearance-index == 6 ? YomeriColors.surface-hover : Theme.appearance-index == 5 ? ShanghaiColors.surface-hover : Theme.appearance-index == 4 ? HiillosColors.surface-hover : Theme.appearance-index == 3 ? SpruceColors.surface-hover : Theme.dark ? DarkColors.surface-hover : LightColors.surface-hover;
    out property <color> table-header: Theme.appearance-index == 9 ? RevontuliColors.table-header : Theme.appearance-index == 8 ? RuusuColors.table-header : Theme.appearance-index == 7 ? KanervaColors.table-header : Theme.appearance-index == 6 ? YomeriColors.table-header : Theme.appearance-index == 5 ? ShanghaiColors.table-header : Theme.appearance-index == 4 ? HiillosColors.table-header : Theme.appearance-index == 3 ? SpruceColors.table-header : Theme.dark ? DarkColors.table-header : LightColors.table-header;
