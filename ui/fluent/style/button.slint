// AS2026: yhteinen teema- ja tehosteporttisovitus; ks. ../README.md.

import { FluentFontSettings, FluentPalette, Icons } from "styling.slint";
import { FocusBorder } from "components.slint";
import { Theme } from "../../theme.slint";

export component Button {
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> primary;
    in property <bool> icon-only: false;
    in property <bool> menu-button: false;
    // AS2026 preset API. Unset variant preserves existing primary behavior.
    in property <string> visual-variant: "standard";
    in property <length> control-height: Theme.control-height;
    in property <bool> enabled <=> i-touch-area.enabled;
    in property <bool> checkable;
    in property <bool> colorize-icon;
    out property <bool> has-focus: i-focus-scope.has-focus;
    out property <bool> pressed: self.enabled && i-touch-area.pressed;
    in-out property <bool> checked;

    callback clicked;

    private property <bool> is-primary: root.primary || root.visual-variant == "primary";
    private property <bool> is-danger: root.visual-variant == "danger";
    private property <bool> is-subtle: root.visual-variant == "subtle";
    private property <brush> text-color: root.is-danger ? Theme.danger : root.is-primary || checked ? FluentPalette.accent-foreground : FluentPalette.control-foreground;

    min-width: max(root.icon-only ? root.control-height : Theme.control-min-width, i-layout.min-width);
    min-height: max(root.control-height, i-layout.min-height);
    preferred-height: root.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: i-focus-scope;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { i-touch-area.clicked(); }

    states [
        disabled when !root.enabled : {
            i-background.background: root.is-primary || root.checked ? FluentPalette.accent-disabled : FluentPalette.control-disabled;
            i-border.border-color: root.is-primary || root.checked || root.is-subtle ? transparent : FluentPalette.border;
            root.text-color: root.is-primary || root.checked ? FluentPalette.text-accent-foreground-disabled : FluentPalette.text-disabled;
        }
        pressed when root.pressed : {
            i-background.background: root.is-danger ? Theme.danger-soft : root.is-primary || root.checked ? FluentPalette.tertiary-accent-background : FluentPalette.control-tertiary;
            i-border.border-color: FluentPalette.border;
            root.text-color: root.is-danger ? Theme.danger : root.is-primary || root.checked ? FluentPalette.text-accent-foreground-secondary : FluentPalette.text-secondary;
        }
        hover when i-touch-area.has-hover : {
            i-background.background: root.is-danger ? Theme.danger-soft : root.is-primary || root.checked ? FluentPalette.secondary-accent-background : FluentPalette.control-secondary;
        }
        checked when root.checked : {
            i-background.background: FluentPalette.accent-background;
            i-border.border-color: FluentPalette.accent-control-border;
            root.text-color: FluentPalette.accent-foreground;
        }
    ]

    i-background := Rectangle {
        border-radius: Theme.radius;
        background: root.is-danger ? Theme.surface-raised : root.is-primary ? FluentPalette.accent-background : root.is-subtle ? transparent : FluentPalette.control-background;
        animate background { enabled: Theme.effects-enabled; duration: 120ms; }

        i-border := Rectangle {
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: root.is-danger ? Theme.danger : root.is-primary ? FluentPalette.accent-control-border : root.is-subtle ? transparent : FluentPalette.control-border;
        }

        i-layout := HorizontalLayout {
            padding-left: root.icon-only ? 0px : Theme.space-3;
            padding-right: root.icon-only ? 0px : Theme.space-3;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-1;
            spacing: Theme.space-1;
            alignment: center;

            if (root.icon.width > 0 && root.icon.height > 0) : Image {
                y: (parent.height - self.height) / 2;
                source <=> root.icon;
                width: root.icon-size;
                min-height: root.icon-size;
                colorize: root.colorize-icon ? root.text-color : transparent;
                accessible-role: none;
            }

            if (root.text != ""): Text {
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.text;
                color: root.text-color;

                accessible-role: none;
            }
            if root.menu-button: Rectangle {
                width: 12px;
                vertical-stretch: 1;
                accessible-role: none;
                Image {
                    y: (parent.height - self.height) / 2;
                    source: Icons.dropdown;
                    width: 12px;
                    height: 12px;
                    colorize: root.text-color;
                    accessible-role: none;
                }
            }
        }
    }

    i-touch-area := TouchArea {
        clicked => {
            if (root.checkable) {
                root.checked = !root.checked;
            }
            root.clicked();
        }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0; // Do not react on clicks
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                i-touch-area.clicked();
                 return accept;
            }

            return reject;
        }
    }

    // focus border
    if (root.has-focus && root.enabled) : FocusBorder {
        border-radius: i-background.border-radius;
    }
}
