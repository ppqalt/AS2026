import { UiButton as Button, UiTextField as LineEdit, UiComboBox as ComboBox, UiScrollView as ScrollView, UiCheckBox as CheckBox } from "presets.slint";
import { ClassSelection } from "class-selection.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { ResultEntryInput, DrawClassOption } from "types.slint";
component PublishField inherits VerticalLayout {
    in property <ResultEntryInput> field;
    in property <bool> writable;
    callback edited(int, string);
    spacing: 4px;
    Note { text: root.field.label; }
    LineEdit {
        text: root.field.value;
        enabled: root.writable;
        input-type: root.field.key == 3 ? InputType.password : InputType.text;
        edited => { root.edited(root.field.key, self.text); }
    }
}
export component LivePublishDialog inherits Rectangle {
    in property <[ResultEntryInput]> fields;
    private property <bool> advanced-open: false;
    in property <string> status;
    in property <bool> running;
    in property <bool> busy;
    in-out property <int> protocol;
    in property <[DrawClassOption]> classes;
    callback class-toggled(int, bool);
    callback classes-all(bool);
    callback local();
    callback edited(int, string);
    callback test();
    callback toggle();
    callback finish();
    callback close();
    background: Theme.modal-backdrop;
    TouchArea {}
    Timer { interval: 1ms; running: true; triggered => { self.running = false; cancel.focus(); } }
    FocusScope {
        width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            reject
        }
        DialogSurface {
            available-width: root.width; available-height: root.height;
            preferred-dialog-width: 840px;
            minimum-dialog-height: 520px; maximum-dialog-height: 1200px;
            content-dialog-height: publish-content.min-height + 108px + 150px;
            Heading { x: Theme.dialog-padding; y: Theme.dialog-padding; text: "Live-tulosten julkaisu"; }
            Note { x: Theme.dialog-padding; y: 60px; width: parent.width - 2 * Theme.dialog-padding; height: 40px;
                text: "Julkaisu koskee tätä kilpailua tällä koneella. Vain yksi kone julkaisee samaan osoitteeseen. Salasana säilyy vain muistissa."; }
            ScrollView {
                x: Theme.dialog-padding; y: 108px; width: parent.width - 2 * Theme.dialog-padding;
                height: parent.height - 108px - 150px;
                publish-content := VerticalLayout {
                    spacing: Theme.space-2; padding-right: 12px;
                    Note { text: "Julkaistavat luokat – jokainen omalla kiertävällä sivullaan"; }
                    ClassSelection {
                        height: max(220px, 124px + ceil(root.classes.length / 2) * 48px + 24px); vertical-stretch: 0;
                        classes: root.classes; writable: !root.running && !root.busy;
                        toggle(index, selected) => { root.class-toggled(index, selected); }
                        select-all(selected) => { root.classes-all(selected); }
                    }
                    ComboBox {
                        model: ["SFTP (salattu)", "FTP (salaamaton)"];
                        current-index <=> root.protocol;
                        enabled: !root.running && !root.busy;
                        selected(index) => {
                            root.edited(1, self.current-index == 1 ? "21" : "22");
                        }
                    }
                    if root.protocol == 1: Note { text: "FTP lähettää salasanan ja tulokset salaamatta. Käytä vain harkitusti."; }
                    PublishField { field: root.fields[0]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    PublishField { field: root.fields[2]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    PublishField { field: root.fields[3]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    if root.protocol == 0: PublishField { field: root.fields[5]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    PublishField { field: root.fields[6]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: root.advanced-open ? "Piilota lisäasetukset" : "Lisäasetukset";
                            clicked => { root.advanced-open = !root.advanced-open; }
                        }
                    }
                    if root.advanced-open: VerticalLayout {
                        spacing: Theme.space-2;
                        PublishField { field: root.fields[1]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                        if root.protocol == 0: PublishField { field: root.fields[4]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                        PublishField { field: root.fields[7]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                        PublishField { field: root.fields[8]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                        PublishField { field: root.fields[9]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                        PublishField { field: root.fields[10]; writable: !root.running && !root.busy; edited(key, value) => { root.edited(key, value); } }
                    }
                }
            }
            Note { x: Theme.dialog-padding; y: parent.height - 140px; width: parent.width - 2 * Theme.dialog-padding; height: 78px; text: root.status; }
            DialogActions {
                x: Theme.dialog-padding; y: parent.height - Theme.dialog-padding - Theme.control-height;
                width: parent.width - 2 * Theme.dialog-padding; height: Theme.control-height;
                cancel := Button { text: "Sulje"; clicked => { root.close(); } }
                if !root.running: Button { text:"Paikallinen live"; enabled:!root.busy; clicked => {root.local();} }
                if !root.running: Button { text: root.busy ? "Testataan…" : "Testaa yhteys"; enabled: !root.busy && !root.running; clicked => { root.test(); } }
                if root.running: Button { text: "Julkaise lopullisina"; enabled: !root.busy; clicked => { root.finish(); } }
                AccentButton { text: root.running ? "Lopeta julkaiseminen" : "Aloita julkaiseminen"; enabled: !root.busy; clicked => { root.toggle(); } }
            }
        }
    }
}
