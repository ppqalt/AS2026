import { UiButton as Button, UiTextField as LineEdit, UiScrollView as ScrollView } from "presets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { ResultEntryInput } from "types.slint";

component EntryLine inherits Rectangle {
    height: Theme.control-height + 24px;
    in property <ResultEntryInput> data;
    in property <int> index;
    in property <int> focus-index;
    callback edited(int, string);
    callback next(int);
    callback focused(int);
    vertical-stretch: 0;
    init => { if root.index == 0 { focus-timer.running = true; } }
    changed focus-index => { if root.focus-index == root.index { focus-timer.running = true; } }
    focus-timer := Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            if root.focus-index == root.index { input.focus(); input.select-all(); }
        }
    }
    field-label := Note { x: 0px; y: 0px; width: parent.width; height: 20px; text: root.data.label; }
    Rectangle {
        x: 0px; y: 24px; width: parent.width;
        height: Theme.control-height;
        FocusScope {
        width: parent.width; height: parent.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Tab { root.next(root.index + (event.modifiers.shift ? -1 : 1)); return accept; }
            reject
        }
        input := LineEdit {
            width: parent.width; height: parent.height;
            text: root.data.value;
            edited => { root.edited(root.data.key, self.text); }
            changed has-focus => { if self.has-focus { root.focused(root.index); } }
        }
        }
    }
}
export component ResultEntryDialog inherits Rectangle {
    in property <string> identity;
    in property <string> queued;
    in property <[ResultEntryInput]> fields;
    in property <string> error;
    in-out property <int> focus-index: 0;
    callback edited(int, string);
    callback close(bool);
    callback save();
    background: Theme.modal-backdrop;
    TouchArea { }
    FocusScope {
        width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            if event.text == Key.Return && !save.has-focus && !cancel.has-focus { root.close(true); return accept; }
            if event.text == Key.Tab && root.focus-index >= 0 && root.focus-index < root.fields.length {
                let next = root.focus-index + (event.modifiers.shift ? -1 : 1);
                if next < 0 { root.focus-index = -1; print.focus(); }
                else if next >= root.fields.length { root.focus-index = -1; cancel.focus(); }
                else { root.focus-index = next; }
                return accept;
            }
            if event.text == Key.Tab && print.has-focus {
                if event.modifiers.shift { save.focus(); }
                else { root.focus-index = 0; }
                return accept;
            }
            if event.text == Key.Tab && save.has-focus {
                if event.modifiers.shift { cancel.focus(); } else { print.focus(); }
                return accept;
            }
            if event.text == Key.Tab && cancel.has-focus {
                if event.modifiers.shift { root.focus-index = root.fields.length - 1; } else { save.focus(); }
                return accept;
            }
            reject
        }
        DialogSurface {
            available-width: root.width; available-height: root.height;
            preferred-dialog-height: 720px;
            Heading { x: Theme.dialog-padding; y: Theme.dialog-padding; width: parent.width - 2 * Theme.dialog-padding; height: 28px; text: "Täydennä tulos"; }
            Note { x: Theme.dialog-padding; y: 60px; width: parent.width - 2 * Theme.dialog-padding; height: 20px; text: root.identity; }
            Note { x: Theme.dialog-padding; y: 84px; width: parent.width - 2 * Theme.dialog-padding; height: root.queued == "" ? 24px : 52px; text: root.queued == "" ? "Kellonajat muodossa h:min:s. Siirry kentästä toiseen Tab-näppäimellä." : root.queued; }
            Rectangle {
                x: Theme.dialog-padding; y: root.queued == "" ? 120px : 148px; width: parent.width - 2 * Theme.dialog-padding;
                height: max(0px, parent.height - self.y - Theme.dialog-padding - Theme.control-height - Theme.space-3 - (root.error == "" ? 0px : 48px));
                clip: true;
                body := ScrollView {
                    width: parent.width; height: parent.height;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: entry-content.min-height;
                    entry-content := VerticalLayout {
                        x: 0px; y: 0px;
                        width: body.visible-width; height: self.min-height;
                        alignment: start; spacing: Theme.space-3;
                        for field[i] in root.fields: EntryLine {
                            data: field; index: i; focus-index: root.focus-index;
                            edited(key, value) => { root.edited(key, value); }
                            focused(index) => {
                                root.focus-index = index;
                                let top = index * (Theme.control-height + 24px + Theme.space-3);
                                let bottom = top + Theme.control-height + 24px;
                                if top < -body.content-y { body.content-y = -top; }
                                else if bottom > -body.content-y + body.visible-height { body.content-y = min(0px, body.visible-height - bottom); }
                            }
                            next(index) => {
                                if index < 0 { root.focus-index = -1; print.focus(); }
                                else if index >= root.fields.length { root.focus-index = -1; cancel.focus(); }
                                else { root.focus-index = index; }
                            }
                        }
                    }
                }
            }
            if root.error != "": Note { x: Theme.dialog-padding; y: parent.height - Theme.dialog-padding - Theme.control-height - 48px; width: parent.width - 2 * Theme.dialog-padding; height: 44px; text: root.error; color: Theme.danger; }
            DialogActions {
                x: Theme.dialog-padding; y: parent.height - Theme.dialog-padding - Theme.control-height;
                width: parent.width - 2 * Theme.dialog-padding; height: Theme.control-height;
                cancel := Button { changed has-focus => { if self.has-focus { root.focus-index = -1; } } text: "Peruuta"; clicked => { root.close(false); } }
                save := Button { changed has-focus => { if self.has-focus { root.focus-index = -1; } } text: "Tallenna"; clicked => { root.save(); } }
                print := AccentButton { changed has-focus => { if self.has-focus { root.focus-index = -1; } } text: "Tallenna ja tulosta"; clicked => { root.close(true); } }
            }
        }
    }
}
