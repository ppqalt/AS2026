import { UiButton as Button, UiTextField as LineEdit, UiComboBox as ComboBox, UiScrollView as ScrollView } from "presets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { EditorField } from "types.slint";
export component EmitCorrectionDialog inherits Rectangle {
    in property <string> identity;
    in property <[EditorField]> fields;
    in property <string> error;
    in property <string> history;
    in property <[string]> competitors;
    in-out property <int> driver;
    callback select-driver(int);
    in-out property <string> card;
    in property <bool> new-card;
    in property <[string]> routes;
    in-out property <int> route;
    callback template(int);
    callback insert(int);
    callback edited(int, string);
    callback close(bool);
    callback add(bool);
    background: Theme.modal-backdrop;
    TouchArea { }
    FocusScope {
        width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            reject
        }
        DialogSurface {
            available-width: root.width; available-height: root.height;
            preferred-dialog-width: 860px; preferred-dialog-height: 740px;
            VerticalLayout {
                padding: Theme.dialog-padding; spacing: Theme.space-3;
                Heading { text: root.new-card ? "Luo Emit-leimarivi" : "Muokkaa Emit-leimauksia"; }
                Note { text: root.identity; }
                ComboBox { model: root.competitors; current-index <=> root.driver; selected => { root.select-driver(self.current-index); } }
                VerticalLayout {
                    spacing: Theme.space-1;
                    vertical-stretch: 0;
                    Text { text: "Emit-numero"; color: Theme.muted; font-size: Theme.label-font-size; }
                    LineEdit { text <=> root.card; accessible-label: "Emit-numero"; }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    ComboBox { model: root.routes; current-index <=> root.route; accessible-label: "Emit-pohjan rata"; }
                    Button { text: "Tuo radan Emit-numerot"; enabled: root.route >= 0; clicked => { root.template(root.route); } }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    vertical-stretch: 0;
                    alignment: start;
                    Button { text: "+ Lisää alkuun"; clicked => { root.insert(-1); } }
                    Button { text: "Palauta alkuperäiset leimat"; clicked => { root.add(true); } }
                }
                Note { text: "Yksi leima rivillä. Anna kellonaika hhmmss tai hh:mm:ss. Alkuperäinen korttiluku säilyy historiassa. Tallennus laskee tulokset uudelleen ja poistaa hyväksynnät."; }
                body := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width; content-height: content.min-height;
                    content := VerticalLayout {
                        width: body.visible-width; height: self.min-height;
                        spacing: Theme.space-2; alignment: start;
                        for field[i] in root.fields: Rectangle {
                            height: Math.mod(i, 3) == 0 ? Theme.control-height : 0px;
                            visible: Math.mod(i, 3) == 0;
                            HorizontalLayout {
                            spacing: Theme.space-2;
                            LineEdit { preferred-width: 100px; accessible-label: "Leimasin"; text: field.value; edited => { root.edited(field.key, self.text); } }
                            LineEdit { horizontal-stretch: 1; accessible-label: "Kellonaika"; text: root.fields[i + 1].value; placeholder-text: "hhmmss"; edited => { root.edited(root.fields[i + 1].key, self.text); } }
                            Button { text: "Poista"; clicked => { root.edited(field.key + 2, "1"); } }
                            Button { text: "Lisää leima"; clicked => { root.insert(i / 3); } }
                            }
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: Theme.danger; wrap: word-wrap; vertical-stretch: 0; }
                DialogActions {
                    Button { text: "Peruuta"; clicked => { root.close(false); } }
                    AccentButton { text: "Tallenna korjaus"; clicked => { root.close(true); } }
                }
            }
        }
    }
}
