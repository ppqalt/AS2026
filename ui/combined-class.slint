import { ClassSelection } from "class-selection.slint";
import { UiButton as Button, UiComboBox as ComboBox, UiTextField as LineEdit } from "presets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, AccentButton, DialogSurface, DialogActions } from "components.slint";
import { DrawClassOption } from "types.slint";

export component CombinedClassDialog inherits Rectangle {
    in property <bool> creating;
    in-out property <string> name;
    in property <[DrawClassOption]> classes;
    in-out property <int> np;
    in-out property <int> sp;
    in property <string> error;

    callback toggle(int, bool);
    callback select-all(bool);
    callback close(bool);
    background: Theme.modal-backdrop;
    TouchArea { }
    Timer { interval: 1ms; running: true; triggered => { self.running = false; name-input.focus(); } }
    keys := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close(false); return accept; }
            if event.text == Key.Tab {
                if save.has-focus && !event.modifiers.shift { name-input.focus(); return accept; }
                if name-input.has-focus && event.modifiers.shift { save.focus(); return accept; }
            }
            reject
        }
        DialogSurface {
            available-width: root.width;
            available-height: root.height;
            minimum-dialog-height: 460px; maximum-dialog-height: 1100px;
            preferred-dialog-width: 760px;
            content-dialog-height: form-layout.min-height - choices.min-height + 124px + ceil(root.classes.length / 2) * 48px + 24px;
            form-layout := VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.space-3;
                Heading { text: root.creating ? "Lisää yhdistetty luokka" : "Yhdistetyn luokan tiedot"; vertical-stretch: 0; }
                Note { text: "Luokan nimi"; }
                name-input := LineEdit {
                    text <=> root.name; placeholder-text: "Esimerkiksi A + B";

                }
                Note { text: "Valitse luokat yhteiseen tulosluetteloon. Kilpailijat säilyvät omissa luokissaan."; }
                choices := ClassSelection {
                    min-height: 200px; vertical-stretch: 1;
                    classes: root.classes;
                    toggle(index, selected) => { root.toggle(index, selected); }
                    select-all(selected) => { root.select-all(selected); }
                }
                HorizontalLayout {
                    spacing: Theme.space-3;
                    VerticalLayout {
                        spacing: Theme.space-2;
                        Note { text: "Nousupisteet (Np)"; }
                        np-choice := ComboBox {
                            model: ["Ei", "Kyllä"]; current-index <=> root.np;

                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-2;
                        Note { text: "Sarjapisteet (Sp)"; }
                        ComboBox {
                            model: ["Ei", "100 pisteen taulukko", "60 pisteen taulukko", "16 pisteen taulukko", "Oma pistetaulukko", "100 pisteen perintä", "60 pisteen perintä"];
                            current-index <=> root.sp;

                        }
                    }
                }
                if root.sp == 4: Note { text: "Oma pistetaulukko määritetään kilpailun asetuksissa."; }
                if root.error != "": Note { text: root.error; color: Theme.danger; }
                DialogActions {
                    Button { text: "Peruuta";  clicked => { root.close(false); } }
                    save := AccentButton { text: root.creating ? "Lisää luokka" : "Tallenna";  clicked => { root.close(true); } }
                }
            }
        }
    }
}
