// AS2026 Fluent 2 beta — reusable control presets.
// All dimensions are AS2026 presets, not Microsoft's certified WinUI measurements.
// Existing Rust callbacks and UI behavior remain unchanged.
// See docs/FLUENT2_KOMPONENTTISTANDARDI.md before adding variants.
import { Button, LineEdit, ComboBox, CheckBox, ScrollView, Slider, Switch, SpinBox, TextEdit, RadioGroup, TabWidget, ProgressIndicator, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Existing Button has keyboard navigation, accessible-role and FocusBorder.
// Reuse it instead of introducing another Rectangle + TouchArea button.
export component UiButton inherits Button {
    in property <string> preset-size: "default";       // compact | default | large
    in property <string> preset-variant: "standard";  // standard | primary | subtle | danger
    control-height: root.preset-size == "compact" ? Theme.control-compact :
                    root.preset-size == "large" ? Theme.control-large : Theme.control-height;
    max-height: root.control-height;
    visual-variant: root.preset-variant;
    primary: root.preset-variant == "primary";
    // A named action cannot shrink below the existing text minimum.
}

export component UiTextField inherits LineEdit {
    in property <string> preset-size: "default"; // compact | default | large
    control-height: root.preset-size == "compact" ? Theme.control-compact :
                    root.preset-size == "large" ? Theme.control-large : Theme.control-height;
}

export component UiComboBox inherits ComboBox {
    in property <string> preset-size: "default";
    control-height: root.preset-size == "compact" ? Theme.control-compact :
                    root.preset-size == "large" ? Theme.control-large : Theme.control-height;
}

export component UiCheckBox inherits CheckBox {
    in property <string> preset-size: "default";
    min-height: root.preset-size == "compact" ? Theme.control-compact :
                root.preset-size == "large" ? Theme.control-large : Theme.control-height;
}

export component UiScrollView inherits ScrollView {
    // Keep scrollbar ownership, keyboard and touch handling in Slint's
    // existing accessible ScrollView. The 14px reserved track is shared.
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
}

export component UiCard inherits Rectangle {
    in property <bool> raised: false;
    background: root.raised ? Theme.surface-raised : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.radius;
    @children
}

export component UiSeparator inherits Rectangle {
    preferred-height: 1px;
    min-height: 1px;
    max-height: 1px;
    vertical-stretch: 0;
    background: Theme.line;
}

// Slintin 1.18.1-pohja omistaa fokus-, hiiri-, näppäin- ja saavutettavuuslogiikan.
// Ei käytetä kilpailun täsmällisiin kellonaikoihin tai pisteisiin.
export component UiSlider inherits Slider {
    in property <string> label: "Arvo";
    in property <string> preset-size: "default";
    thumb-diameter: root.preset-size == "large" ? 24px : 20px;
    preferred-width: 260px;
    min-width: 100px;
    preferred-height: root.preset-size == "large" ? Theme.control-large : Theme.control-height;
    accessible-label: root.label;
}

export component UiSwitch inherits Switch {
    min-height: Theme.control-height;
}

export component UiSpinBox inherits SpinBox {
    in property <string> preset-size: "default";
    control-height: root.preset-size == "compact" ? Theme.control-compact : root.preset-size == "large" ? Theme.control-large : Theme.control-height;
}

export component UiTextArea inherits TextEdit {
    min-height: 100px;
    preferred-height: 120px;
    wrap: word-wrap;
}

export component UiRadioGroup inherits RadioGroup { }
export component UiTabs inherits TabWidget { }
export component UiListView inherits ListView { }

export component UiProgressBar inherits ProgressIndicator {
    min-height: 4px;
    accessible-label: root.indeterminate ? "Työ käynnissä" : "Työn eteneminen";
}

export component UiIconButton inherits UiButton {
    in property <string> label;
    icon-only: true;
    accessible-label: root.label;
}

export component UiMenuButton inherits UiButton {
    in property <bool> expanded: false;
    menu-button: true;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
}

export component UiInfoBar inherits Rectangle {
    in property <string> severity: "info";
    in property <string> text;
    in property <string> action-text;
    callback action();
    background: root.severity == "error" ? Theme.danger-soft : Theme.surface-raised;
    border-color: root.severity == "error" ? Theme.danger : root.severity == "warning" ? Theme.warning : Theme.line;
    border-width: 1px;
    border-radius: Theme.radius;
    min-height: info-layout.min-height;
    accessible-role: groupbox;
    accessible-label: root.text;
    info-layout := HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;
        Text {
            text: root.severity == "error" ? "Virhe:" : root.severity == "warning" ? "Huomio:" : root.severity == "success" ? "Valmis:" : "Tieto:";
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
        Text { text: root.text; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
        if root.action-text != "": UiButton { text: root.action-text; clicked => { root.action(); } }
    }
}

export component UiEmptyState inherits VerticalLayout {
    in property <string> title: "Ei tietoja";
    in property <string> description;
    in property <string> action-text;
    callback action();
    spacing: Theme.space-2;
    Text { text: root.title; color: Theme.ink; font-size: Theme.section-font-size; font-weight: 600; wrap: word-wrap; }
    Text { text: root.description; color: Theme.muted; wrap: word-wrap; }
    if root.action-text != "": UiButton { text: root.action-text; clicked => { root.action(); } }
}

export component UiValidationMessage inherits Text {
    in property <string> severity: "error";
    color: root.severity == "warning" ? Theme.warning : root.severity == "success" ? Theme.success : Theme.danger;
    font-size: Theme.label-font-size;
    wrap: word-wrap;
}
